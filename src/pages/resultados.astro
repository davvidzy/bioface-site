---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ResultadosGrade from '@/components/sections/ResultadosGrade.astro';
import CtaFinal from '@/components/sections/CtaFinal.astro';
import { resultados as t, AVISO_RESULTADOS } from '@/data/textos';
import {
  resultadosPublicaveis,
  nomeDoProcedimento,
  procedimentosComResultado,
} from '@/lib/conteudo';

const resultados = await resultadosPublicaveis();
const itens = await Promise.all(
  resultados.map(async (resultado) => ({
    resultado,
    procedimento: await nomeDoProcedimento(resultado),
  })),
);
// Filtro só com tratamentos que têm resultado. Sem nenhum, o filtro não aparece.
const filtros = await procedimentosComResultado();
---

<BaseLayout title={t.seo.title} description={t.seo.description} path="/resultados">
  <div class="container section">
    <SectionHeader nivel="h1" titulo={t.titulo} intro={t.intro} />

    {filtros.length > 0 && (
      <div class="filtro" data-filtro hidden>
        <p id="filtro-rotulo" class="t-label">
          {t.filtro}
        </p>
        <ul class="list-reset" role="list" aria-labelledby="filtro-rotulo">
          <li>
            <button type="button" class="t-label" data-filtro-valor="" aria-pressed="true">
              {t.filtroTodos}
            </button>
          </li>
          {filtros.map((p) => (
            <li>
              <button type="button" class="t-label" data-filtro-valor={p.id} aria-pressed="false">
                {p.data.nome}
              </button>
            </li>
          ))}
        </ul>
        <p class="visually-hidden" aria-live="polite" data-filtro-status />
      </div>
    )}

    <ResultadosGrade itens={itens} aviso={AVISO_RESULTADOS} prioritarias={1} />
  </div>

  <CtaFinal titulo={t.cta.titulo} texto={t.cta.texto} origem="resultados" />
</BaseLayout>

<style>
  .filtro {
    margin-block-end: var(--space-6);
  }

  .filtro ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .filtro button {
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--color-border-default);
    border-radius: var(--radius-m);
    background: transparent;
  }

  .filtro button[aria-pressed='true'] {
    background-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
    border-color: var(--color-action-primary-bg);
  }
</style>

<script>
  // Enhancement: sem JS, todos os resultados aparecem e o filtro fica oculto.
  function montarFiltro() {
    const filtro = document.querySelector<HTMLElement>('[data-filtro]');
    const grade = document.querySelector<HTMLElement>('[data-resultados-grade]');
    if (!filtro || !grade) return;
    filtro.hidden = false;
    const botoes = filtro.querySelectorAll<HTMLButtonElement>('[data-filtro-valor]');
    const status = filtro.querySelector<HTMLElement>('[data-filtro-status]');
    botoes.forEach((botao) =>
      botao.addEventListener('click', () => {
        const valor = botao.dataset['filtroValor'] ?? '';
        botoes.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));
        let visiveis = 0;
        grade.querySelectorAll<HTMLElement>(':scope > li').forEach((item) => {
          const mostra = !valor || item.dataset['procedimento'] === valor;
          item.hidden = !mostra;
          if (mostra) visiveis += 1;
        });
        if (status) status.textContent = `${visiveis} resultado(s) exibido(s).`;
      }),
    );
  }

  document.addEventListener('astro:page-load', montarFiltro);
</script>
