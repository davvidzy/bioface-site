---
/**
 * Home: landing page única (CLAUDE.md, seção 6.1). Ordem: Hero, Credenciais, Tratamentos,
 * Resultados, Método, Maria, Depoimentos, Espaço, FAQ, CTA final.
 * Seções sem material (depoimentos reais, fotos do espaço) ficam fora até chegar o conteúdo.
 * O header usa âncoras destas seções (data/textos.ts → navegacao).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Credenciais from '@/components/sections/Credenciais.astro';
import TratamentosCategorias from '@/components/sections/TratamentosCategorias.astro';
import ResultadosPrevia from '@/components/sections/ResultadosPrevia.astro';
import Metodo from '@/components/sections/Metodo.astro';
import SobrePrevia from '@/components/sections/SobrePrevia.astro';
import Depoimentos from '@/components/sections/Depoimentos.astro';
import Faq from '@/components/sections/Faq.astro';
import CtaFinal from '@/components/sections/CtaFinal.astro';
import Transicao from '@/components/ui/Transicao.astro';

import { home } from '@/data/textos';
import {
  getProcedimentosPorCategoria,
  resultadosPublicaveis,
  nomeDoProcedimento,
  getDepoimentos,
  getFaqGeral,
} from '@/lib/conteudo';
import { jsonLdLocalBusiness, jsonLdFaq } from '@/lib/seo';
import { preloadsHero } from '@/lib/hero';

const grupos = await getProcedimentosPorCategoria();
const resultados = await resultadosPublicaveis();
const resultadosItens = await Promise.all(
  resultados.map(async (resultado) => ({
    resultado,
    procedimento: await nomeDoProcedimento(resultado),
  })),
);
const depoimentosPublicados = (await getDepoimentos()).filter((d) => !d.data.pendente);
// Todas aparecem na prévia; as pendentes (validar com a Maria) ficam fora do JSON-LD.
const faq = (await getFaqGeral()).map((f) => f.data);
const totalTratamentos = grupos.reduce((n, g) => n + g.procedimentos.length, 0);
const credenciais = [
  ...home.credenciais.slice(0, 2),
  `${totalTratamentos} tratamentos`,
  ...home.credenciais.slice(2),
];
const preloads = await preloadsHero();

const catalogo = grupos.map((g) => ({
  nome: g.categoria.rotulo,
  itens: g.procedimentos.map((p) => p.data.nome),
}));
const jsonLd = [jsonLdLocalBusiness(Astro.site, catalogo), jsonLdFaq(faq)].filter(
  (ld): ld is Record<string, unknown> => ld !== null,
);
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  path="/"
  jsonLd={jsonLd}
  headerSobreposto
>
  <Fragment slot="head">
    {preloads.map((p) => (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        media={p.media}
        imagesrcset={p.srcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    ))}
  </Fragment>

  {/* Narrativa de luz: a página começa no creme e escurece aos poucos até o vinho. */}
  <Hero {...home.hero} />
  <Credenciais itens={credenciais} />
  <TratamentosCategorias {...home.tratamentos} grupos={grupos} />
  <Transicao de="var(--cream-50)" para="var(--cream-100)" />
  <ResultadosPrevia {...home.resultados} itens={resultadosItens} />
  <Transicao de="var(--cream-100)" para="var(--wine-900)" altura="clamp(8rem, 20vw, 18rem)" />
  <Metodo {...home.metodo} />
  <SobrePrevia {...home.sobre} />
  {depoimentosPublicados.length > 0 && (
    <Depoimentos {...home.depoimentos} depoimentos={depoimentosPublicados} />
  )}
  {/* TODO(conteudo): seção "O espaço" volta quando houver fotos da clínica. */}
  <Faq {...home.faq} ancora="duvidas" itens={faq} tema="escuro" />
  <Transicao de="var(--wine-900)" para="var(--wine-950)" />
  <CtaFinal {...home.ctaFinal} origem="cta-final" comLocalizacao />
</BaseLayout>
