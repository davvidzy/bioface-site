---
/**
 * Template de tratamento, gerado da collection.
 * pendente: true → noindex e fora do sitemap.
 */
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Texto from '@/components/ui/Texto.astro';
import Pendente from '@/components/ui/Pendente.astro';
import ProcedimentoCard from '@/components/ui/ProcedimentoCard.astro';
import ResultadosGrade from '@/components/sections/ResultadosGrade.astro';
import Faq from '@/components/sections/Faq.astro';
import CtaFinal from '@/components/sections/CtaFinal.astro';
import { getCategoria } from '@/data/categorias';
import { tratamento as t, AVISO_RESULTADOS } from '@/data/textos';
import {
  getProcedimentos,
  resultadosDoProcedimento,
  corpoVazio,
  type Procedimento,
} from '@/lib/conteudo';
import { jsonLdBreadcrumb, jsonLdFaq, type Migalha } from '@/lib/seo';

export const getStaticPaths = (async () => {
  const procedimentos = await getProcedimentos();
  return procedimentos.map((procedimento) => ({
    params: { slug: procedimento.id },
    props: { procedimento },
  }));
}) satisfies GetStaticPaths;

interface Props {
  procedimento: Procedimento;
}

const { procedimento } = Astro.props;
const { data, body } = procedimento;
const categoria = getCategoria(data.categoria);
const { Content } = await render(procedimento);
const semCorpo = corpoVazio(body);

const path = `/tratamentos/${procedimento.id}`;
const migalhas: Migalha[] = [
  { nome: t.breadcrumbRaiz, href: '/tratamentos' },
  { nome: categoria.rotulo, href: `/tratamentos#${categoria.slug}` },
  { nome: data.nome },
];

const expectativa = (
  Object.entries(t.expectativaRotulos) as [keyof typeof t.expectativaRotulos, string][]
)
  .map(([chave, rotulo]) => ({ rotulo, valor: data.expectativa[chave] }))
  .filter((e): e is { rotulo: string; valor: string } => Boolean(e.valor));

const resultados = await resultadosDoProcedimento(procedimento.id);
const relacionados = await getEntries(data.relacionados);

const jsonLd = [jsonLdBreadcrumb(migalhas, Astro.site, path), jsonLdFaq(data.faq)].filter(
  (ld): ld is Record<string, unknown> => ld !== null,
);
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  path={path}
  noindex={data.pendente}
  jsonLd={jsonLd}
  procedimento={data.nome}
>
  <div class="container hero">
    <Breadcrumb migalhas={migalhas} />
    <p class="eyebrow t-eyebrow">{categoria.rotulo}</p>
    <h1 class="t-display-l">{data.nome}</h1>
    <Texto texto={data.problema} class="t-body-l text-secondary" />
  </div>

  <Section labelledby="para-quem">
    <h2 id="para-quem" class="t-h2" data-reveal="fade">
      {t.paraQuem}
    </h2>
    {data.paraQuem.length > 0 ? (
      <ul class="lista">
        {data.paraQuem.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    ) : (
      <Pendente texto="indicações deste tratamento, validadas pela Maria." />
    )}
  </Section>

  <Section labelledby="como-funciona" sutil>
    <h2 id="como-funciona" class="t-h2" data-reveal="fade">
      {t.comoFunciona}
    </h2>
    {semCorpo ? (
      <Pendente texto="como o tratamento funciona, em texto clínico validado pela Maria." />
    ) : (
      <div class="prosa">
        <Content />
      </div>
    )}
  </Section>

  <Section labelledby="expectativa">
    <h2 id="expectativa" class="t-h2" data-reveal="fade">
      {t.expectativa}
    </h2>
    {expectativa.length > 0 ? (
      <dl class="expectativa">
        {expectativa.map((e) => (
          <div>
            <dt class="t-eyebrow">{e.rotulo}</dt>
            <dd>{e.valor}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <Pendente texto="sessões, duração, recuperação, início e duração do resultado." />
    )}
  </Section>

  {resultados.length > 0 && (
    <Section labelledby="resultados" tema="escuro">
      <h2 id="resultados" class="t-h2" data-reveal="fade">
        {t.resultados}
      </h2>
      <ResultadosGrade
        itens={resultados.map((resultado) => ({ resultado, procedimento: data.nome }))}
        aviso={AVISO_RESULTADOS}
      />
    </Section>
  )}

  <Faq
    id="faq-tratamento"
    titulo={t.faq}
    itens={data.faq}
    pendente="perguntas frequentes deste tratamento."
  />

  {relacionados.length > 0 && (
    <Section labelledby="relacionados" sutil>
      <h2 id="relacionados" class="t-h2" data-reveal="fade">
        {t.relacionados}
      </h2>
      <ul class="list-reset grid" role="list">
        {relacionados.map((p) => (
          <li>
            <ProcedimentoCard procedimento={p} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  <CtaFinal
    titulo={t.cta.titulo}
    texto={t.cta.texto}
    origem="tratamento"
    procedimento={data.nome}
  />
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
  }

  .lista,
  .expectativa,
  .prosa,
  :global(.section) > .container > ul.grid {
    margin-block-start: var(--space-5);
  }

  .lista {
    display: grid;
    gap: var(--space-2);
    padding-inline-start: 1.25em;
  }

  .expectativa {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }

  .expectativa dt {
    color: var(--color-text-accent);
  }

  .prosa > :global(* + *) {
    margin-block-start: var(--space-4);
  }

  :global(.section) h2 + :global(.placeholder) {
    margin-block-start: var(--space-5);
  }
</style>
