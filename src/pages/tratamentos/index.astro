---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ProcedimentoCard from '@/components/ui/ProcedimentoCard.astro';
import CtaFinal from '@/components/sections/CtaFinal.astro';
import { tratamentosIndice as t } from '@/data/textos';
import { getProcedimentosPorCategoria } from '@/lib/conteudo';

const grupos = await getProcedimentosPorCategoria();
---

<BaseLayout title={t.seo.title} description={t.seo.description} path="/tratamentos">
  <div class="container section">
    <SectionHeader nivel="h1" titulo={t.titulo} intro={t.intro} />

    <nav aria-label={t.navegacao} class="categorias-nav">
      <ul class="list-reset" role="list">
        {grupos.map(({ categoria }) => (
          <li>
            <a href={`#${categoria.slug}`} class="t-label">
              {categoria.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {grupos.map(({ categoria, procedimentos }) => (
      <section id={categoria.slug} aria-labelledby={`${categoria.slug}-titulo`} class="categoria">
        <h2 id={`${categoria.slug}-titulo`} class="t-h2" data-reveal="fade">
          {categoria.rotulo}
        </h2>
        <p class="t-body-l text-secondary">{categoria.descricao}</p>
        <ul class="list-reset grid" role="list">
          {procedimentos.map((p) => (
            <li>
              <ProcedimentoCard procedimento={p} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <CtaFinal titulo={t.cta.titulo} texto={t.cta.texto} origem="tratamentos-indice" />
</BaseLayout>

<style>
  .categorias-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .categorias-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  .categoria {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-9);
  }

  .categoria > ul {
    margin-block-start: var(--space-4);
  }
</style>
