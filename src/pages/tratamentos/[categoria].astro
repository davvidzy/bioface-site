---
/**
 * Página de uma categoria de tratamentos (aberta pelos cards da Home).
 *
 * 1. Hero: migalhas, nome do objetivo em display, frase de apoio, CTA e um link de texto
 *    para quem não sabe por onde começar; à direita, duas fotos em alturas diferentes.
 * 2. Cards dos tratamentos: foto, nome em serifa e a dor numa frase. Cada card abre o
 *    WhatsApp com o nome do tratamento na mensagem.
 * 3. Outros objetivos e CTA final.
 *
 * TODO(conteudo): fotos do hero (2) e de cada tratamento; por enquanto, placeholders.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import Transicao from '@/components/ui/Transicao.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import CtaFinal from '@/components/sections/CtaFinal.astro';
import Accordion from '@/components/ui/Accordion.astro';
import { jsonLdFaq } from '@/lib/seo';
import { CATEGORIAS } from '@/data/categorias';
import { getProcedimentosPorCategoria, isPendente } from '@/lib/conteudo';
import { buildWhatsAppLink } from '@/lib/whatsapp';
import { site } from '@/data/site';
import { home } from '@/data/textos';

export function getStaticPaths() {
  return CATEGORIAS.map((categoria) => ({ params: { categoria: categoria.slug } }));
}

const grupos = await getProcedimentosPorCategoria();
const grupo = grupos.find((g) => g.categoria.slug === Astro.params.categoria);
if (!grupo) return Astro.redirect('/404');
const { categoria, procedimentos } = grupo;
const outras = grupos.filter((g) => g.categoria.slug !== categoria.slug);

const comFaq = procedimentos.filter((p) => p.data.faq.length > 0);
const jsonLd = [jsonLdFaq(comFaq.flatMap((p) => p.data.faq))].filter(
  (ld): ld is Record<string, unknown> => ld !== null,
);

const titulo = `${categoria.rotulo} | ${site.marca}`;
const descricao = `${categoria.descricao} ${procedimentos.map((p) => p.data.nome).join(', ')}. Avaliação individual com ${site.responsavel.nome} no ${site.endereco.bairro}, ${site.endereco.cidade}.`;
---

<BaseLayout
  title={titulo}
  description={descricao}
  path={`/tratamentos/${categoria.slug}`}
  jsonLd={jsonLd}
>
  <!-- ---------- Hero ---------- -->
  <section class="cat-hero com-marca-dagua" aria-labelledby="categoria-titulo">
    <MarcaDagua lado="esquerda" base="-8%" corte={0.45} opacidade={0.06} giro={-6} />
    <div class="container cat-hero__grade">
      <div class="cat-hero__texto entrada">
        <nav aria-label="Você está em" class="migalhas">
          <a href="/#tratamentos">Tratamentos</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{categoria.curto}</span>
        </nav>
        <h1 id="categoria-titulo" class="cat-hero__titulo">
          {categoria.rotulo}
        </h1>
        <p class="cat-hero__descricao">{categoria.descricao}</p>
        <div class="cat-hero__acoes">
          <WhatsAppLink
            origem="tratamentos"
            rotulo="Agendar avaliação"
            complementoOculto={`para ${categoria.rotulo.toLowerCase()} pelo WhatsApp`}
            procedimento={categoria.rotulo.toLowerCase()}
          />
          <WhatsAppLink
            origem="tratamentos"
            rotulo="Dúvidas? Fale com a Maria →"
            variante="texto"
            class="cat-hero__ajuda"
          />
        </div>
      </div>

      <div class="cat-hero__fotos entrada-foto" aria-hidden="true">
        <div class="placeholder-media cat-hero__foto cat-hero__foto--grande">
          <span>Foto 1 · {categoria.curto}</span>
        </div>
        <div class="placeholder-media cat-hero__foto cat-hero__foto--pequena">
          <span>Foto 2</span>
        </div>
      </div>
    </div>
  </section>

  {/* Degradê que funde o hero (creme) com a lista (creme mais fundo). */}
  <Transicao de="var(--cream-50)" para="var(--cream-100)" />

  <!-- ---------- Tratamentos ---------- -->
  <section class="cat-lista" aria-labelledby="lista-titulo">
    <div class="container">
      <h2 id="lista-titulo" class="t-display-l cat-lista__titulo" data-reveal="lines">
        Tratamentos
      </h2>
      <ul class="list-reset cards" role="list" data-reveal="stagger">
        {procedimentos.map((p) => {
          const problema = isPendente(p.data.problema) ? undefined : p.data.problema;
          return (
            <li>
              <a
                class="card-trat"
                href={buildWhatsAppLink({ procedimento: p.data.nome, origem: 'tratamentos' })}
                target="_blank"
                rel="noopener noreferrer"
                data-track="whatsapp_click"
                data-origem="tratamentos"
                data-procedimento={p.data.nome}
              >
                <span class="placeholder-media card-trat__foto" aria-hidden="true">
                  <span>Foto · {p.data.nome}</span>
                </span>
                <span class="card-trat__nome">{p.data.nome}</span>
                {problema && <span class="card-trat__problema">{problema}</span>}
                <span class="visually-hidden">
                  : agendar avaliação pelo WhatsApp (abre o WhatsApp em nova aba)
                </span>
              </a>
            </li>
          );
        })}
      </ul>

      {comFaq.length > 0 && (
        <section class="faq-cat" aria-labelledby="faq-cat-titulo">
          <div class="faq-cat__cabeca">
            <h2 id="faq-cat-titulo" class="t-display-l" data-reveal="lines">
              Perguntas frequentes
            </h2>
          </div>
          <div class="faq-cat__grupos">
            {comFaq.map((p) => (
              <div class="faq-cat__grupo">
                <h3 class="faq-cat__tratamento">{p.data.nome}</h3>
                <Accordion itens={p.data.faq} />
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="outras" aria-labelledby="outras-titulo">
        <h2 id="outras-titulo" class="outras__titulo">
          Outros objetivos
        </h2>
        <ul class="list-reset outras__lista" role="list" data-reveal="stagger">
          {outras.map((g) => (
            <li>
              <a class="outras__link" href={`/tratamentos/${g.categoria.slug}`}>
                <span class="outras__nome">{g.categoria.rotulo}</span>
                <span class="outras__qtd">{g.procedimentos.length} tratamentos</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>

  <Transicao de="var(--cream-100)" para="var(--wine-950)" altura="clamp(8rem, 20vw, 16rem)" />
  <CtaFinal {...home.ctaFinal} origem="cta-final" />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  /* Um pouco mais alto: o hero ocupa quase a tela toda, com o conteúdo no meio. */
  .cat-hero {
    display: grid;
    align-items: center;
    min-height: calc(100svh - 6.75rem);
    padding-block: var(--space-6) var(--space-8);
  }

  .cat-hero__grade {
    display: grid;
    gap: var(--space-9);
    align-items: center;
  }

  .cat-hero__texto {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .migalhas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .migalhas a,
  .migalhas > span {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  .migalhas [aria-current] {
    color: var(--color-text-primary);
  }

  .cat-hero__titulo {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: clamp(2.5rem, 1.6rem + 2.8vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    /* Nunca quebrar palavra no meio ("rejuvenescimento"). */
    overflow-wrap: normal;
    hyphens: manual;
    text-wrap: balance;
    margin-block: var(--space-3) var(--space-5);
  }

  .cat-hero__descricao {
    max-width: 30rem;
    font-size: var(--text-body-l);
    color: var(--color-text-secondary);
  }

  .cat-hero__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-block-start: var(--space-3);
  }

  .cat-hero__acoes :global(.cat-hero__ajuda) {
    font-size: var(--text-body-s);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  /* Duas fotos em alturas diferentes, com fio fino por dentro (como na referência). */
  .cat-hero__fotos {
    display: grid;
    grid-template-columns: 3fr 2fr;
    align-items: center;
    gap: var(--space-4);
  }

  .cat-hero__foto {
    position: relative;
  }

  .cat-hero__foto::after,
  .card-trat__foto::after {
    content: '';
    position: absolute;
    inset: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 14%, transparent);
    border-radius: calc(var(--radius-l) - var(--space-2));
    pointer-events: none;
  }

  .cat-hero__foto--grande {
    --ratio: 2 / 3;
  }

  .cat-hero__foto--pequena {
    --ratio: 4 / 7;
  }

  @media (min-width: 56rem) {
    .cat-hero__grade {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-10);
    }
  }

  /* ---------- Lista de tratamentos ---------- */
  .cat-lista {
    padding-block: var(--space-section);
    background-color: var(--color-bg-subtle);
  }

  .cat-lista__titulo {
    margin-block-end: var(--space-8);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-8) var(--space-5);
  }

  .card-trat {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .card-trat__foto {
    --ratio: 3 / 4;
    position: relative;
    margin-block-end: var(--space-3);
    background:
      radial-gradient(120% 90% at 30% 20%, var(--cream-50), transparent 60%),
      color-mix(in srgb, var(--gold-200) 35%, var(--cream-100));
    transition:
      translate var(--motion-fluido),
      box-shadow var(--motion-fluido);
  }

  .card-trat__nome {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    transition: translate var(--motion-fluido);
  }

  .card-trat__problema {
    font-size: var(--text-body-s);
    color: var(--color-text-secondary);
  }

  .card-trat:hover .card-trat__foto {
    translate: 0 -4px;
    box-shadow: 0 22px 40px -28px rgb(43 20 32 / 0.45);
  }

  .card-trat:hover .card-trat__nome {
    translate: var(--space-2) 0;
  }

  /* ---------- Perguntas frequentes dos tratamentos ---------- */
  .faq-cat {
    display: grid;
    gap: var(--space-7);
    margin-block-start: var(--space-section);
  }

  .faq-cat__grupos {
    display: grid;
    gap: var(--space-8);
  }

  .faq-cat__tratamento {
    margin-block-end: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
  }

  @media (min-width: 56rem) {
    .faq-cat {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-9);
      align-items: start;
    }

    .faq-cat__cabeca {
      position: sticky;
      inset-block-start: 7rem;
    }
  }

  /* ---------- Outros objetivos ---------- */
  .outras {
    margin-block-start: var(--space-10);
  }

  .outras__titulo {
    margin-block-end: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-body-m);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
  }

  .outras__lista {
    border-block-start: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 30%, transparent);
  }

  .outras__lista > li {
    border-block-end: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 30%, transparent);
  }

  .outras__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .outras__nome {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    line-height: 1.1;
    transition: translate var(--motion-fluido);
  }

  .outras__qtd {
    font-size: var(--text-body-s);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .outras__link:hover .outras__nome {
    translate: var(--space-3) 0;
  }

  /* Celular: hero centralizado, como na Home. */
  @media (max-width: 55.99rem) {
    .cat-hero__texto {
      justify-items: center;
      text-align: center;
    }

    .cat-hero__acoes {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-trat__foto,
    .card-trat__nome,
    .outras__nome {
      transition: none;
    }

    .card-trat:hover .card-trat__foto,
    .card-trat:hover .card-trat__nome {
      translate: none;
    }
  }
</style>
