---
/**
 * Header: navegar e converter de qualquer ponto.
 * Landing page única: os links são âncoras das seções da Home.
 * `sobreposto`: fica por cima do hero, sem fundo (a Home usa assim).
 * Sem menu hambúrguer: no mobile os links descem para uma segunda linha, sem JS.
 */
import Wordmark from '@/assets/brand/wordmark-mono.svg';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import { site } from '@/data/site';
import { navegacao } from '@/data/textos';

interface Props {
  sobreposto?: boolean;
}

const { sobreposto = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--sobreposto': sobreposto }]}>
  <div class="container site-header__inner">
    <a href="/" class="site-header__marca" aria-label={`${site.marca}, página inicial`}>
      <Wordmark aria-hidden="true" focusable="false" class="site-header__wordmark" />
    </a>
    <nav aria-label="Principal">
      <ul class="site-header__links list-reset" role="list">
        {navegacao.map((link) => (
          <li>
            <a href={`/#${link.ancora}`} class="t-label">
              {link.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <WhatsAppLink
      origem="header"
      rotulo="Agendar avaliação"
      complementoOculto="pelo WhatsApp"
      class="site-header__cta"
    />
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--border-width) solid var(--color-border-default);
    background-color: var(--color-bg-default);
  }

  .site-header--sobreposto {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
    border-block-end: 0;
    background-color: transparent;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-4);
  }

  .site-header__marca {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text-primary);
  }

  .site-header__wordmark {
    width: 9rem;
    height: auto;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }

  .site-header__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
  }

  .site-header__links a:hover {
    text-decoration: underline;
  }

  /* No mobile a navegação sai: a landing é rolagem contínua e o CTA fica visível.
     Um menu próprio entra na fase de design, se fizer falta. */
  @media (max-width: 48rem) {
    nav {
      display: none;
    }

    .site-header__inner {
      column-gap: var(--space-3);
    }

    .site-header__wordmark {
      width: 7.5rem;
    }

    .site-header__inner :global(.site-header__cta) {
      padding-inline: var(--space-4);
    }
  }
</style>
