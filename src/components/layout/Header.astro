---
/**
 * Header: navegar e converter de qualquer ponto.
 * Landing page única: os links são âncoras das seções da Home.
 *
 * Dois estados, no mesmo elemento e na mesma transição contínua:
 * - topo: sem fundo, tema claro, logo em vinho (versão mono), menor e com mais respiro;
 * - ao rolar (data-flutuante, aplicado em BaseLayout): pílula suspensa em tema escuro
 *   (vinho), com o logo nas cores originais (âmbar) e links creme.
 * - suspenso sobre uma seção escura (data-sobre-escuro): a pílula inverte para creme, com
 *   logo e links em vinho, para manter o contraste com o fundo vinho que passa atrás.
 * O BaseLayout troca o data-theme da barra junto com esses estados.
 * O <header> mantém a altura no lugar para a página não pular. Sem JS: fica estático.
 * No celular: logo + botão de menu. O menu é um popover nativo (funciona sem JS e fica na
 * camada superior, fora dos transforms da barra): tela cheia em vinho, abre da esquerda para
 * a direita com fade; logo de um lado, X discreto do outro, links em serifa grande e o CTA
 * embaixo. Fecha no X, com Esc (o foco volta ao botão) ou ao tocar num link.
 */
import Marca from '@/components/ui/Marca.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import { site } from '@/data/site';
import { navegacao } from '@/data/textos';

interface Props {
  sobreposto?: boolean;
}

const { sobreposto = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--sobreposto': sobreposto }]} data-header>
  <div class="site-header__barra" data-header-barra>
    <a href="/" class="site-header__marca" aria-label={`${site.marca}, página inicial`}>
      <span class="site-header__logo site-header__logo--mono" aria-hidden="true">
        <Marca tipo="monograma" class="site-header__icone" />
        <Marca tipo="wordmark" class="site-header__wordmark" />
      </span>
      <span class="site-header__logo site-header__logo--cor" aria-hidden="true">
        <Marca tipo="monograma" cor="cor" class="site-header__icone" />
        <Marca tipo="wordmark" cor="cor" class="site-header__wordmark" />
      </span>
    </a>
    <nav aria-label="Principal">
      <ul class="site-header__links list-reset" role="list">
        {navegacao.map((link) => (
          <li>
            <a href={`/#${link.ancora}`} class="t-label">
              {link.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <WhatsAppLink
      origem="header"
      rotulo="Agendar avaliação"
      complementoOculto="pelo WhatsApp"
      class="site-header__cta"
    />

    <button
      type="button"
      class="menu-movel__botao"
      popovertarget="menu-movel"
      aria-label="Abrir menu"
      data-menu-botao
    >
      <span class="menu-movel__icone" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <div
      id="menu-movel"
      class="menu-movel"
      popover
      role="dialog"
      aria-label="Menu"
      data-theme="escuro"
      data-menu-movel
      data-lenis-prevent
    >
      <MarcaDagua
        lado="direita"
        base="-8%"
        tamanho="22rem"
        corte={0.38}
        opacidade={0.06}
        giro={8}
        parallax={false}
      />
      <div class="menu-movel__topo">
        <a
          href="/"
          class="menu-movel__marca"
          aria-label={`${site.marca}, página inicial`}
          data-menu-link
        >
          <Marca tipo="monograma" cor="cor" class="menu-movel__icone-marca" />
          <Marca tipo="wordmark" cor="cor" class="menu-movel__wordmark" />
        </a>
        <button
          type="button"
          class="menu-movel__fechar"
          popovertarget="menu-movel"
          popovertargetaction="hide"
          aria-label="Fechar menu"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <nav aria-label="Menu" class="menu-movel__nav">
        <ul class="list-reset menu-movel__links" role="list">
          {navegacao.map((link, i) => (
            <li class="menu-movel__item" style={`--i: ${i}`}>
              <a href={`/#${link.ancora}`} data-menu-link>
                {link.rotulo}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="menu-movel__item menu-movel__rodape" style={`--i: ${navegacao.length}`}>
        <WhatsAppLink
          origem="menu"
          rotulo="Agendar avaliação"
          complementoOculto="pelo WhatsApp"
          class="menu-movel__cta"
        />
      </div>
    </div>
  </div>
</header>

<script>
  /*
   * Menu do celular (popover nativo). Abrir, fechar no X e Esc já vêm do navegador.
   * Aqui: fechar ao tocar num link e deixar o resto da página inerte enquanto ele está
   * aberto (o foco fica dentro do menu e o leitor de tela não lê o que está por trás).
   */
  const menu = () => document.querySelector<HTMLElement>('[data-menu-movel]');
  const inertes: Element[] = [];
  function alternarInerte(aberto: boolean) {
    inertes.splice(0).forEach((el) => el.removeAttribute('inert'));
    const m = menu();
    if (!aberto || !m) return;
    for (let no: Element | null = m; no && no !== document.body; no = no.parentElement) {
      for (const irmao of no.parentElement?.children ?? []) {
        if (irmao === no || irmao.hasAttribute('inert')) continue;
        irmao.setAttribute('inert', '');
        inertes.push(irmao);
      }
    }
  }
  function alinharTopo(m: HTMLElement) {
    const botao = document.querySelector('[data-menu-botao]')?.getBoundingClientRect();
    const marca = document.querySelector('.site-header__marca')?.getBoundingClientRect();
    if (botao) {
      m.style.setProperty('--fechar-topo', `${botao.top}px`);
      m.style.setProperty('--fechar-direita', `${window.innerWidth - botao.right}px`);
    }
    if (marca) {
      m.style.setProperty('--marca-topo', `${marca.top}px`);
      m.style.setProperty('--marca-esquerda', `${marca.left}px`);
      m.style.setProperty('--marca-altura', `${marca.height}px`);
    }
  }
  function prepararMenu() {
    const m = menu();
    if (!m || m.dataset['pronto'] !== undefined) return;
    m.dataset['pronto'] = '';
    // beforetoggle: antes de abrir, alinha logo e X ao lugar exato do logo e do botão da
    // barra (que mudam entre o topo e a pílula); antes de fechar, tira o inert para o
    // navegador conseguir devolver o foco ao botão.
    m.addEventListener('beforetoggle', (e) => {
      const abrindo = (e as ToggleEvent).newState === 'open';
      if (abrindo) alinharTopo(m);
      alternarInerte(abrindo);
    });
    // Ao abrir, o foco entra no menu (no X); ao fechar pelo X ou Esc, volta ao botão.
    let porLink = false;
    m.addEventListener('toggle', (e) => {
      if ((e as ToggleEvent).newState === 'open') {
        m.querySelector<HTMLElement>('.menu-movel__fechar')?.focus({ preventScroll: true });
      } else if (!porLink) {
        document.querySelector<HTMLElement>('[data-menu-botao]')?.focus({ preventScroll: true });
      }
      porLink = false;
    });
    m.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('[data-menu-link]')) return;
      porLink = true;
      m.hidePopover();
    });
  }
  document.addEventListener('astro:page-load', prepararMenu);
  document.addEventListener('astro:before-swap', () => {
    const m = menu();
    if (m?.matches(':popover-open')) m.hidePopover();
    alternarInerte(false);
  });

  /*
   * Onde a pessoa está: marca com aria-current o link da seção que ocupa a faixa central
   * da tela. Fora das seções do menu (hero, CTA final), nenhum fica marcado.
   */
  let observador: IntersectionObserver | null = null;
  function marcarSecaoAtual() {
    observador?.disconnect();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-header] a[href^="/#"]')];
    const secoes = [...new Set(links.map((l) => l.hash.slice(1)))]
      .map((id) => document.getElementById(id))
      .filter((s): s is HTMLElement => s !== null);
    if (secoes.length === 0) return;
    const visiveis = new Set<string>();
    const atualizar = () => {
      const atual = secoes.find((s) => visiveis.has(s.id))?.id;
      links.forEach((l) => {
        if (l.hash.slice(1) === atual) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      });
    };
    observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) visiveis.add(e.target.id);
          else visiveis.delete(e.target.id);
        });
        atualizar();
      },
      // Faixa fina no meio da tela: só uma seção por vez cruza a linha.
      { rootMargin: '-45% 0px -55% 0px' },
    );
    secoes.forEach((s) => observador?.observe(s));
  }
  document.addEventListener('astro:page-load', marcarSecaoAtual);
</script>

<style>
  /*
   * A barra é sempre fixa no topo. Os dois estados são o mesmo elemento: ao rolar,
   * ela desce alguns pixels, estreita, arredonda e ganha fundo e sombra, em transição
   * contínua (morph). O <header> guarda a altura no fluxo para a página não pular.
   */
  .site-header {
    --altura: 6.75rem;
    --altura-flutuante: 3.75rem;
    /* Mesma duração do site, mas com aceleração e desaceleração suaves: com o ease-out
       padrão a troca topo → pílula acontecia quase toda nos primeiros 100ms (brusca). */
    --morph: var(--duration-fluida) var(--ease-in-out-soft);
    min-height: var(--altura);
  }

  .site-header--sobreposto {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
  }

  .site-header__barra {
    position: fixed;
    inset-block-start: 0;
    /* Centrada por margens automáticas (e não left 50% + transform): no Safari, o transform
       somado à largura animada fazia a barra e o texto tremerem durante a transição. */
    inset-inline: 0;
    margin-inline: auto;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    width: 100%;
    min-height: var(--altura);
    /* Conteúdo alinhado ao container do resto da página, com a barra de borda a borda. */
    padding: 0 max(var(--gutter), (100% - var(--container-max)) / 2 + var(--gutter));
    border-radius: 0;
    background-color: color-mix(in srgb, var(--wine-900) 0%, transparent);
    box-shadow:
      0 0 0 rgb(43 20 32 / 0),
      0 0 0 rgb(43 20 32 / 0);
    translate: 0 0;
    transition:
      translate var(--morph),
      inset-block-start var(--morph),
      width var(--morph),
      min-height var(--morph),
      padding var(--morph),
      border-radius var(--morph),
      background-color var(--morph),
      box-shadow var(--morph);
  }

  /* ---------- Oculto: sobe para fora da tela ao rolar para baixo ----------
   * Escondida, só o deslize anima; a forma (pílula, cor, largura) muda depois que ela já
   * saiu da tela. Assim a primeira saída do topo é um deslize limpo (antes a barra virava
   * pílula e subia ao mesmo tempo) e, ao voltar, ela já desce pronta, sem se transformar.
   */
  .site-header[data-oculto] .site-header__barra {
    translate: 0 calc(-100% - var(--space-5));
    transition:
      translate var(--morph),
      inset-block-start 0s var(--duration-fluida),
      width 0s var(--duration-fluida),
      min-height 0s var(--duration-fluida),
      padding 0s var(--duration-fluida),
      border-radius 0s var(--duration-fluida),
      background-color 0s var(--duration-fluida),
      box-shadow 0s var(--duration-fluida);
  }

  .site-header[data-oculto] .site-header__logo {
    transition:
      opacity 0s var(--duration-fluida),
      gap 0s var(--duration-fluida);
  }

  /* ---------- Estado suspenso ---------- */
  .site-header[data-flutuante] .site-header__barra {
    inset-block-start: var(--space-3);
    width: min(68rem, calc(100% - 2 * var(--space-3)));
    min-height: var(--altura-flutuante);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-6);
    border-radius: 2.5rem;
    background-color: color-mix(in srgb, var(--wine-900) 94%, transparent);
    box-shadow: var(--shadow-flutuante);
    /* Sem transição no desfoque: no Safari, animar backdrop-filter pisca a barra. */
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  /* Sobre seção escura: pílula creme (tema claro), para destacar do vinho. */
  .site-header[data-flutuante][data-sobre-escuro] .site-header__barra {
    background-color: color-mix(in srgb, var(--cream-50) 94%, transparent);
    box-shadow: 0 16px 40px -20px rgb(0 0 0 / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__barra,
    .site-header__logo,
    .site-header__logo > :global(.marca) {
      transition: none;
    }
  }

  /*
   * Logo completo do Figma (node 12:2): monograma BF + wordmark, nas cores originais.
   * Tudo escala por --logo (largura do wordmark), mantendo as proporções do arquivo:
   * ícone = 0,317 × wordmark; espaço entre eles = 0,084 × wordmark.
   */
  .site-header__marca {
    --logo: 7.25rem;
    display: grid;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text-primary);
  }

  /* As duas versões do logo ocupam o mesmo lugar; o estado decide qual aparece. */
  .site-header__logo {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo) * 0.084);
    transition:
      opacity var(--morph),
      gap var(--morph);
  }

  .site-header__logo--cor {
    opacity: 0;
  }

  .site-header[data-flutuante]:not([data-sobre-escuro]) .site-header__logo--mono {
    opacity: 0;
  }

  .site-header[data-flutuante]:not([data-sobre-escuro]) .site-header__logo--cor {
    opacity: 1;
  }

  .site-header__icone {
    width: calc(var(--logo) * 0.317);
    height: auto;
    transition: width var(--morph);
  }

  .site-header__wordmark {
    width: var(--logo);
    height: auto;
    transition: width var(--morph);
  }

  /* ---------- Navegação: barra que cresce sob o texto ----------
   * Hover: a barra cresce da esquerda para a direita; ao sair, recolhe para a direita.
   * Seção atual (aria-current, marcado pelo script ao rolar): barra inteira e fixa.
   */
  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
  }

  .site-header__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
  }

  .site-header__links a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.6rem;
    height: 1.5px;
    border-radius: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--motion-fluido);
  }

  .site-header__links a:hover::after,
  .site-header__links a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: 0% 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__links a::after {
      transition: none;
    }
  }

  /* ---------- Menu do celular ---------- */
  .menu-movel__botao {
    display: none;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    background-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
    /* Fundo e ícone trocam juntos, no mesmo ritmo da barra (o ícone mudava de uma vez). */
    transition:
      background-color var(--morph),
      color var(--morph);
  }

  .menu-movel__icone {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .menu-movel__icone span {
    display: block;
    height: 1.5px;
    border-radius: 1px;
    background-color: currentColor;
  }

  .menu-movel__icone span:last-child {
    width: 65%;
    justify-self: end;
  }

  /*
   * Painel em tela cheia. O popover fica na camada superior do navegador, então o
   * position: fixed vale para a tela inteira, mesmo com a barra transformada.
   * Abre revelando da esquerda para a direita (clip-path) junto com um fade; fecha
   * recolhendo no sentido contrário. Links e CTA entram em sequência logo depois.
   */
  .menu-movel {
    position: fixed;
    inset: 0;
    flex-direction: column;
    width: 100%;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) max(var(--space-8), env(safe-area-inset-bottom));
    border: 0;
    /* Cabe inteiro na tela: sem rolagem dentro do menu. */
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
    isolation: isolate;
    background-color: var(--color-bg-default);
    color: var(--color-text-primary);
    clip-path: inset(0 100% 0 0);
    opacity: 0;
    transition:
      clip-path var(--motion-fluido),
      opacity var(--motion-fluido),
      display var(--duration-fluida) allow-discrete,
      overlay var(--duration-fluida) allow-discrete;
  }

  .menu-movel:popover-open {
    display: flex;
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }

  @starting-style {
    .menu-movel:popover-open {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
    }
  }

  .menu-movel::backdrop {
    background: transparent;
  }

  /* Sem rolagem da página por trás enquanto o menu está aberto. */
  :global(html:has(.menu-movel:popover-open)) {
    overflow: hidden;
  }

  /*
   * Logo e X ficam exatamente onde estavam o logo e o botão da barra (posições medidas
   * pelo script ao abrir). Sem JS, valem os valores padrão do topo da página.
   */
  .menu-movel__topo {
    flex: none;
    min-height: 6.75rem;
  }

  .menu-movel__marca {
    --logo: 6.25rem;
    position: absolute;
    inset-block-start: var(--marca-topo, 1.84rem);
    inset-inline-start: var(--marca-esquerda, var(--gutter));
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo) * 0.084);
    height: var(--marca-altura, 3.08rem);
    min-height: var(--tap-min);
  }

  .menu-movel__marca :global(.menu-movel__icone-marca) {
    width: calc(var(--logo) * 0.317);
    height: auto;
  }

  .menu-movel__marca :global(.menu-movel__wordmark) {
    width: var(--logo);
    height: auto;
  }

  /* X discreto: dois fios finos, sem fundo; só um aro sutil e um giro no hover. */
  .menu-movel__fechar {
    position: absolute;
    inset-block-start: var(--fechar-topo, 2.0rem);
    inset-inline-end: var(--fechar-direita, var(--gutter));
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: none;
    color: var(--color-text-primary);
    cursor: pointer;
    transition:
      border-color var(--motion-fluido),
      rotate var(--motion-fluido);
  }

  .menu-movel__fechar span {
    grid-area: 1 / 1;
    width: 1.125rem;
    height: 1px;
    background-color: currentColor;
    rotate: 45deg;
  }

  .menu-movel__fechar span:last-child {
    rotate: -45deg;
  }

  .menu-movel__fechar:hover {
    border-color: color-mix(in srgb, var(--color-border-default) 45%, transparent);
    rotate: 90deg;
  }

  .menu-movel__nav {
    margin-block: auto;
    padding-block: var(--space-6);
  }

  .menu-movel__links {
    display: grid;
    gap: var(--space-2);
  }

  .menu-movel__links a {
    display: flex;
    align-items: center;
    min-height: min(4rem, 8dvh);
    font-family: var(--font-display);
    font-size: min(clamp(2.5rem, 1.5rem + 5vw, 3.5rem), 6.5dvh);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--color-text-primary);
    transition:
      translate var(--motion-fluido),
      color var(--motion-fluido);
  }

  .menu-movel__links a:hover {
    translate: var(--space-2) 0;
    color: var(--color-text-accent);
  }

  .menu-movel__rodape :global(.menu-movel__cta) {
    width: 100%;
  }

  /* Entrada em sequência: cada item desliza da esquerda, um pouco depois do painel. */
  @media (prefers-reduced-motion: no-preference) {
    .menu-movel:popover-open .menu-movel__item {
      animation: menu-item var(--motion-fluido) both;
      animation-delay: calc(180ms + var(--i) * 70ms);
    }
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      translate: -1.5rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-movel,
    .menu-movel__fechar,
    .menu-movel__links a {
      transition: none;
    }
  }

  @media (max-width: 48rem) {
    nav {
      display: none;
    }

    .menu-movel__botao {
      display: grid;
    }

    .menu-movel nav {
      display: block;
    }

    .site-header__barra :global(.site-header__cta) {
      display: none;
    }

    .site-header__barra {
      column-gap: var(--space-3);
    }

    .site-header__marca {
      --logo: 6.25rem;
    }

    .site-header[data-flutuante] .site-header__barra {
