---
/**
 * Header: navegar e converter de qualquer ponto.
 * Landing page única: os links são âncoras das seções da Home.
 *
 * Começa no fluxo (na Home, `sobreposto` ao hero, sem fundo). Ao rolar, a barra vira
 * uma pílula suspensa e arredondada (data-flutuante, aplicado em BaseLayout).
 * O <header> mantém a altura no lugar para a página não pular. Sem JS: fica estático.
 * No mobile a navegação sai: a landing é rolagem contínua e o CTA fica visível.
 */
import Wordmark from '@/assets/brand/wordmark-mono.svg';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import { site } from '@/data/site';
import { navegacao } from '@/data/textos';

interface Props {
  sobreposto?: boolean;
}

const { sobreposto = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--sobreposto': sobreposto }]} data-header>
  <div class="site-header__barra">
    <a href="/" class="site-header__marca" aria-label={`${site.marca}, página inicial`}>
      <Wordmark aria-hidden="true" focusable="false" class="site-header__wordmark" />
    </a>
    <nav aria-label="Principal">
      <ul class="site-header__links list-reset" role="list">
        {navegacao.map((link) => (
          <li>
            <a href={`/#${link.ancora}`} class="t-label">
              {link.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <WhatsAppLink
      origem="header"
      rotulo="Agendar avaliação"
      complementoOculto="pelo WhatsApp"
      class="site-header__cta"
    />
  </div>
</header>

<style>
  .site-header {
    --altura: 5.5rem;
    min-height: var(--altura);
  }

  .site-header--sobreposto {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
  }

  .site-header__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    width: 100%;
    max-width: var(--container-max);
    min-height: var(--altura);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---------- Suspensa ao rolar ---------- */
  .site-header[data-flutuante] .site-header__barra {
    position: fixed;
    inset-block-start: var(--space-3);
    inset-inline: var(--space-3);
    z-index: var(--z-header);
    width: auto;
    max-width: min(var(--container-max), calc(100% - 2 * var(--space-3)));
    min-height: 0;
    margin-inline: auto;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-6);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-bg-default) 92%, transparent);
    box-shadow: var(--shadow-flutuante);
    backdrop-filter: blur(12px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header[data-flutuante] .site-header__barra {
      animation: header-desce var(--duration-base) var(--ease-out-soft);
    }
  }

  @keyframes header-desce {
    from {
      opacity: 0;
      transform: translateY(-120%);
    }
  }

  .site-header__marca {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--color-text-primary);
  }

  .site-header__wordmark {
    width: 9rem;
    height: auto;
  }

  .site-header[data-flutuante] .site-header__wordmark {
    width: 7.5rem;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
  }

  .site-header__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
  }

  .site-header__links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 48rem) {
    nav {
      display: none;
    }

    .site-header__barra {
      column-gap: var(--space-3);
    }

    .site-header__wordmark {
      width: 7.5rem;
    }

    .site-header[data-flutuante] .site-header__barra {
      padding-inline-start: var(--space-4);
    }
  }
</style>
