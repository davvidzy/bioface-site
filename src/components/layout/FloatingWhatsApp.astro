---
/**
 * Botão flutuante de WhatsApp, só no mobile.
 * Some quando o CTA final da página ([data-cta-final]) está visível,
 * para não haver dois CTAs iguais na mesma tela.
 * Sem JS: fica sempre visível (o site continua completo).
 */
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';

interface Props {
  procedimento?: string | undefined;
}

const { procedimento } = Astro.props;
---

<aside class="floating-whatsapp" aria-label="Atalho de agendamento" data-floating-whatsapp>
  <WhatsAppLink
    origem="flutuante"
    procedimento={procedimento}
    rotulo="Agendar avaliação"
    complementoOculto="pelo WhatsApp"
  />
</aside>

<style>
  .floating-whatsapp {
    display: none;
  }

  @media (max-width: 48rem) {
    .floating-whatsapp {
      display: block;
      position: fixed;
      inset-inline: var(--gutter);
      inset-block-end: max(var(--space-4), env(safe-area-inset-bottom));
      z-index: var(--z-floating);
      transition:
        opacity var(--duration-fast) var(--ease-standard),
        visibility var(--duration-fast);
    }

    .floating-whatsapp :global(.btn) {
      width: 100%;
    }

    .floating-whatsapp[data-oculto] {
      opacity: 0;
      visibility: hidden;
    }

    /* Espaço para o botão não cobrir o fim do rodapé. */
    :global(body) {
      padding-block-end: calc(var(--tap-min) + var(--space-7));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-whatsapp {
      transition: none;
    }
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;

  function montar() {
    observer?.disconnect();
    const botao = document.querySelector<HTMLElement>('[data-floating-whatsapp]');
    const alvos = document.querySelectorAll('[data-cta-final]');
    if (!botao || alvos.length === 0) return;
    const visiveis = new Set<Element>();
    observer = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visiveis.add(e.target);
        else visiveis.delete(e.target);
      }
      botao.toggleAttribute('data-oculto', visiveis.size > 0);
    });
    alvos.forEach((a) => observer?.observe(a));
  }

  document.addEventListener('astro:page-load', montar);
  document.addEventListener('astro:before-swap', () => observer?.disconnect());
</script>
