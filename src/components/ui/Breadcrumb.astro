---
import type { Migalha } from '@/lib/seo';

interface Props {
  migalhas: Migalha[];
}

const { migalhas } = Astro.props;
---

<nav aria-label="Você está em" class="breadcrumb t-caption">
  <ol class="list-reset" role="list">
    {migalhas.map((m) => (
      <li>{m.href ? <a href={m.href}>{m.nome}</a> : <span aria-current="page">{m.nome}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  li {
    display: inline-flex;
    align-items: center;
  }

  li + li::before {
    content: '›';
    padding-inline: var(--space-2);
    color: var(--color-text-secondary);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
</style>
