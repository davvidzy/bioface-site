---
/**
 * Comparador antes/depois acessível (CLAUDE.md, seção 9).
 *
 * - Sem JS: as duas fotos lado a lado, cada uma com rótulo. Conteúdo completo.
 * - Com JS: as fotos se sobrepõem e um <input type="range"> nativo controla a divisão.
 *   Teclado (setas, Home, End, PageUp/PageDown) e leitor de tela vêm do input nativo;
 *   o valor é anunciado em porcentagem via aria-valuetext.
 * - Arrastar com mouse ou toque em qualquer ponto da foto é enhancement.
 *
 * Só recebe resultados já filtrados por consentimento (lib/conteudo.ts → resultadosPublicaveis).
 */
import { Picture } from 'astro:assets';
import type { Resultado } from '@/lib/conteudo';

interface Props {
  resultado: Resultado;
  /** Nome do tratamento, quando informado. */
  procedimento?: string | undefined;
  /** Imagem acima da dobra? Desliga o lazy load. */
  prioritaria?: boolean;
}

const { resultado, procedimento, prioritaria = false } = Astro.props;
const { antes, depois, alt, legenda, intervalo } = resultado.data;
const loading = prioritaria ? 'eager' : 'lazy';
const sizes = '(min-width: 48rem) 30vw, 100vw';
const textoLegenda = [procedimento, legenda, intervalo].filter(Boolean).join('. ');
const regiao = alt.antes.replace(/\s+antes do tratamento$/i, '');
// A proporção da foto de antes define o palco; a de depois é recortada para alinhar.
const ratio = `${antes.width} / ${antes.height}`;
const inicial = 50;
---

<figure class="ba" data-ba>
  <div class="ba__palco" style={`--ratio: ${ratio}; --pos: ${inicial}%`} data-ba-palco>
    <div class="ba__camada ba__camada--depois">
      <Picture
        src={depois}
        alt={alt.depois}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[320, 640]}
        sizes={sizes}
        loading={loading}
      />
      <span class="ba__rotulo ba__rotulo--depois t-caption" aria-hidden="true">
        Depois
      </span>
    </div>
    <div class="ba__camada ba__camada--antes">
      <Picture
        src={antes}
        alt={alt.antes}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[320, 640]}
        sizes={sizes}
        loading={loading}
      />
      <span class="ba__rotulo ba__rotulo--antes t-caption" aria-hidden="true">
        Antes
      </span>
    </div>
    <div class="ba__divisor" aria-hidden="true">
      <span class="ba__alca"></span>
    </div>
    <input
      class="ba__controle"
      type="range"
      min="0"
      max="100"
      step="1"
      value={inicial}
      aria-label={`Comparar antes e depois: ${regiao}`}
      aria-valuetext={`${inicial}% antes, ${100 - inicial}% depois`}
      data-ba-controle
      hidden
    />
  </div>
  {textoLegenda && <figcaption class="t-caption ba__legenda">{textoLegenda}</figcaption>}
</figure>

<style>
  /* ---------- Base sem JS: lado a lado ---------- */
  .ba__palco {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .ba__camada {
    position: relative;
  }

  /* Ordem visual sem JS: antes à esquerda, depois à direita. */
  .ba__camada--antes {
    order: -1;
  }

  .ba__camada :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }

  .ba__rotulo {
    position: absolute;
    inset-block-end: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-bg-default);
    color: var(--color-text-primary);
  }

  .ba__rotulo--antes {
    inset-inline-start: var(--space-2);
  }

  .ba__rotulo--depois {
    inset-inline-end: var(--space-2);
  }

  .ba__divisor {
    display: none;
  }

  .ba__legenda {
    margin-block-start: var(--space-2);
  }

  /* ---------- Com JS: comparador por sobreposição ---------- */
  .ba[data-ba-ativo] .ba__palco {
    display: block;
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    touch-action: pan-y; /* rolagem vertical continua; arrasto horizontal é do comparador */
    cursor: ew-resize;
    user-select: none;
  }

  .ba[data-ba-ativo] .ba__camada {
    position: absolute;
    inset: 0;
  }

  .ba[data-ba-ativo] .ba__camada :global(img) {
    -webkit-user-drag: none;
  }

  .ba[data-ba-ativo] .ba__camada--antes {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba[data-ba-ativo] .ba__divisor {
    display: block;
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--pos);
    width: 2px;
    margin-inline-start: -1px;
    background-color: var(--color-bg-default);
    pointer-events: none;
  }

  .ba__alca {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: var(--tap-min);
    height: var(--tap-min);
    translate: -50% -50%;
    border-radius: 50%;
    border: 2px solid var(--color-text-primary);
    background-color: var(--color-bg-default);
  }

  /* O input fica sobre o palco, invisível, só para foco e teclado. */
  .ba__controle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* Foco do input aparece no palco inteiro. */
  .ba[data-ba-ativo] .ba__palco:has(.ba__controle:focus-visible) {
    outline: var(--focus-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-offset);
  }
</style>

<script>
  const montados = new WeakSet<HTMLElement>();

  function montar(ba: HTMLElement) {
    if (montados.has(ba)) return;
    const palco = ba.querySelector<HTMLElement>('[data-ba-palco]');
    const controle = ba.querySelector<HTMLInputElement>('[data-ba-controle]');
    if (!palco || !controle) return;
    montados.add(ba);

    const aplicar = (valor: number) => {
      const v = Math.round(Math.min(100, Math.max(0, valor)));
      controle.value = String(v);
      controle.setAttribute('aria-valuetext', `${v}% antes, ${100 - v}% depois`);
      palco.style.setProperty('--pos', `${v}%`);
    };

    controle.hidden = false;
    ba.setAttribute('data-ba-ativo', '');
    controle.addEventListener('input', () => aplicar(Number(controle.value)));

    // Enhancement: arrastar em qualquer ponto da foto.
    const deEvento = (e: PointerEvent) => {
      const r = palco.getBoundingClientRect();
      aplicar(((e.clientX - r.left) / r.width) * 100);
    };
    let arrastando = false;
    // Sem isso, o drag nativo da <img> cancela o ponteiro no primeiro movimento.
    palco.addEventListener('dragstart', (e) => e.preventDefault());
    palco.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
      arrastando = true;
      palco.setPointerCapture(e.pointerId);
      deEvento(e);
      controle.focus({ preventScroll: true });
    });
    palco.addEventListener('pointermove', (e) => arrastando && deEvento(e));
    const soltar = () => (arrastando = false);
    palco.addEventListener('pointerup', soltar);
    palco.addEventListener('pointercancel', soltar);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-ba]').forEach(montar);
  });
</script>
