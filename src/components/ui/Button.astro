---
/**
 * Botão ou link com aparência de botão, em pílula.
 * Com href vira <a>; sem href vira <button>. Alvo de toque mínimo de 44px.
 * O primário leva uma seta num círculo (decorativa).
 */
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  variante?: 'primario' | 'secundario' | 'destaque';
  href?: string | undefined;
  /** Mostra a seta no círculo. Padrão: só no primário. */
  seta?: boolean;
};

const { variante = 'primario', href, seta, class: className, ...rest } = Astro.props;
const comSeta = seta ?? variante === 'primario';
const classes = ['btn', `btn--${variante}`, { 'btn--seta': comSeta }, 't-label', className];
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    <span class="btn__texto">
      <slot />
    </span>
    {comSeta && (
      <span class="btn__seta" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </span>
    )}
  </a>
) : (
  <button type="button" class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <span class="btn__texto">
      <slot />
    </span>
  </button>
)}

<style>
  /*
   * Hover: um preenchimento varre o botão da esquerda para a direita
   * (--color-action-hover-*) e a seta inverte as cores e avança.
   * Contraste no hover: vinho sobre dourado 9,4:1; no tema escuro, vinho sobre creme 13,5:1.
   */
  .btn {
    --morph: var(--duration-base) var(--ease-out-soft);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-6);
    border: var(--border-width) solid var(--color-action-primary-bg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition:
      color var(--morph),
      border-color var(--morph);
  }

  /* Camada de preenchimento do hover. */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--color-action-hover-bg);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--morph);
  }

  .btn:hover::before {
    transform: scaleX(1);
    transform-origin: 0% 50%;
  }

  .btn--seta {
    padding-inline-end: var(--space-2);
  }

  .btn--primario {
    background-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
  }

  .btn--primario:hover {
    color: var(--color-action-hover-text);
    border-color: var(--color-action-hover-bg);
  }

  /* Destaque: simples. Dourado sólido, sem seta; no hover preenche em vinho. */
  .btn--destaque {
    background-color: var(--color-action-destaque-bg);
    color: var(--color-action-destaque-text);
    border-color: var(--color-action-destaque-bg);
    padding-inline: var(--space-7);
  }

  .btn--destaque::before {
    background-color: var(--color-action-primary-bg);
  }

  .btn--destaque:hover {
    color: var(--color-action-primary-text);
    border-color: var(--color-action-primary-bg);
  }

  .btn--secundario {
    background-color: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  /* Secundário: preenche com a cor do texto e o texto vira o fundo. */
  .btn--secundario::before {
    background-color: var(--color-text-primary);
  }

  .btn--secundario:hover {
    color: var(--color-bg-default);
  }

  .btn__seta {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: var(--color-action-primary-text);
    color: var(--color-action-primary-bg);
    transition:
      transform var(--morph),
      background-color var(--morph),
      color var(--morph);
  }

  .btn__seta svg {
    transition: transform var(--morph);
  }

  .btn--primario:hover .btn__seta {
    background-color: var(--color-action-hover-text);
    color: var(--color-action-hover-bg);
  }

  .btn--secundario .btn__seta {
    background-color: var(--color-text-primary);
    color: var(--color-bg-default);
  }

  .btn--secundario:hover .btn__seta {
    background-color: var(--color-bg-default);
    color: var(--color-text-primary);
  }

  .btn:hover .btn__seta svg {
    transform: translateX(2px) rotate(-45deg);
  }

  .btn:active::before {
    transition-duration: var(--duration-fast);
  }

  /* Celular: pílula mais compacta para caber numa linha. */
  @media (max-width: 30rem) {
    .btn {
      gap: var(--space-3);
      padding-inline: var(--space-5);
    }

    .btn--seta {
      padding-inline-end: var(--space-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn::before,
    .btn__seta,
    .btn__seta svg {
      transition: none;
    }
  }
</style>
