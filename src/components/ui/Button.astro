---
/**
 * Botão em pílula, padrão único de CTA do site.
 * Com href vira <a>; sem href vira <button>. Alvo de toque mínimo de 44px.
 *
 * Hover "fluido" (recriado a partir da referência Fluid Button, do Framer):
 * - um preenchimento em elipse sobe de baixo e, ao cobrir o botão, perde a curva;
 * - o rótulo rola para cima e dá lugar a uma cópia na cor invertida;
 * - o botão cresce 4%.
 * Cores pelo tema da seção: no claro, vinho com texto creme e preenchimento creme;
 * no escuro, dourado com texto vinho e preenchimento vinho. Contraste ≥ 9,4:1 nos dois estados.
 * A cópia do rótulo é aria-hidden: o leitor de tela lê o texto uma vez só.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  /** Texto visível do botão. */
  rotulo: string;
  href?: string | undefined;
};

const { rotulo, href, class: className, ...rest } = Astro.props;
const classes = ['btn', className];
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    <span class="btn__preenchimento" aria-hidden="true"></span>
    <span class="btn__janela">
      <span class="btn__rolo">
        <span class="btn__linha">{rotulo}</span>
        <span class="btn__linha" aria-hidden="true">
          {rotulo}
        </span>
      </span>
    </span>
    <slot />
  </a>
) : (
  <button type="button" class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <span class="btn__preenchimento" aria-hidden="true"></span>
    <span class="btn__janela">
      <span class="btn__rolo">
        <span class="btn__linha">{rotulo}</span>
        <span class="btn__linha" aria-hidden="true">
          {rotulo}
        </span>
      </span>
    </span>
    <slot />
  </button>
)}

<style>
  .btn {
    --fundo: var(--color-action-primary-bg);
    --texto: var(--color-action-primary-text);
    --curva: cubic-bezier(0.4, 0, 0, 1);
    --tempo: var(--duration-fluida) var(--curva);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding: 0.95rem 2.25rem;
    border: 1.5px solid var(--fundo);
    border-radius: var(--radius-pill);
    background-color: var(--fundo);
    color: var(--texto);
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: scale var(--tempo);
  }

  /* Elipse que sobe de baixo; no hover cobre o botão e endireita os cantos. */
  .btn__preenchimento {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: -1;
    height: 110%;
    border-radius: 50%;
    background-color: var(--texto);
    transition:
      top var(--tempo),
      border-radius var(--tempo);
  }

  /* Janela de uma linha: o rolo desliza dentro dela. */
  .btn__janela {
    display: block;
    height: 1.25em;
    overflow: hidden;
  }

  .btn__rolo {
    display: grid;
    transition: translate var(--tempo);
  }

  .btn__linha {
    display: block;
    height: 1.25em;
  }

  .btn__linha + .btn__linha {
    color: var(--fundo);
  }

  .btn:hover {
    scale: 1.04;
  }

  .btn:hover .btn__preenchimento {
    top: -5%;
    border-radius: 0;
  }

  .btn:hover .btn__rolo {
    translate: 0 -1.25em;
  }

  .btn:active {
    scale: 0.98;
  }

  /* Celular: pílula mais compacta. */
  @media (max-width: 30rem) {
    .btn {
      padding-inline: var(--space-6);
    }
  }

  /* Telas bem estreitas (320px): o rótulo longo cabe sem empurrar a página para o lado. */
  @media (max-width: 22.5rem) {
    .btn {
      padding-inline: var(--space-4);
      font-size: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn__preenchimento,
    .btn__rolo {
      transition: none;
    }

    .btn:hover {
      scale: none;
    }
  }
</style>
