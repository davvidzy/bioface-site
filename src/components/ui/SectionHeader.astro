---
/**
 * Título de seção, sem rótulo acima. Um trecho entre *asteriscos* vira itálico
 * (lib/texto.ts). O título carrega data-reveal (fade de entrada).
 */
import { enfase } from '@/lib/texto';

interface Props {
  titulo: string;
  intro?: string | undefined;
  nivel?: 'h1' | 'h2';
  id?: string;
  /** Estilo tipográfico do título. */
  estilo?: 't-display-l' | 't-display-xl' | 't-h2';
  alinhamento?: 'inicio' | 'centro';
}

const { titulo, intro, nivel: Tag = 'h2', id, estilo, alinhamento = 'inicio' } = Astro.props;
const classeTitulo = estilo ?? (Tag === 'h1' ? 't-display-l' : 't-h2');
---

<header class:list={['section-header', { 'section-header--centro': alinhamento === 'centro' }]}>
  <Tag
    id={id}
    class:list={[classeTitulo, 'titulo-enfase']}
    data-reveal="lines"
    set:html={enfase(titulo)}
  />
  {intro && <p class="t-body-l text-secondary">{intro}</p>}
  <slot />
</header>

<style>
  .section-header--centro {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
</style>
