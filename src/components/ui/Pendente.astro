---
/**
 * Placeholder visível para conteúdo que ainda depende da cliente.
 * Sempre marcado: "Conteúdo pendente". Nunca substitui texto por invenção.
 */
import { descricaoPendente } from '@/lib/conteudo';

interface Props {
  /** Texto com ou sem o marcador de pendência. */
  texto?: string;
  as?: 'p' | 'div' | 'span' | 'li';
  class?: string | undefined;
}

const { texto = '', as: Tag = 'p', class: className } = Astro.props;
const descricao = descricaoPendente(texto);
// Rótulo montado aqui para a formatação do markup não inserir espaço antes dos dois-pontos.
const rotulo = descricao ? 'Conteúdo pendente:' : 'Conteúdo pendente';
---

<Tag class:list={['placeholder', className]} data-pendente>
  <strong>{rotulo}</strong>
  {descricao}
  <slot />
</Tag>
