---
/**
 * Elemento de ligação entre seções: um fio fino que desce até um ponto.
 * Decorativo (aria-hidden; por isso usa o primitivo gold/600 direto, sem regra de contraste). Com movimento, o fio "se desenha" ao entrar na tela
 * (data-reveal="linha"); sem JS ou com reduced motion, aparece inteiro.
 */
interface Props {
  /** Altura do fio. */
  altura?: string;
}

const { altura = 'clamp(3rem, 8vw, 6rem)' } = Astro.props;
---

<div class="conector" aria-hidden="true" style={`--altura: ${altura}`}>
  <span class="conector__fio" data-reveal="linha"></span>
  <span class="conector__ponto"></span>
</div>

<style>
  .conector {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .conector__fio {
    display: block;
    width: 1px;
    height: var(--altura);
    background: linear-gradient(180deg, transparent, var(--gold-600) 40%, var(--gold-600));
  }

  .conector__ponto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--gold-600);
  }
</style>
