---
/**
 * Home. Job: diferenciar pelo método e reduzir a ansiedade de quem nunca fez.
 * Junta a antiga "Filosofia" e o "Como funciona": uma frase sobre como a Maria trabalha
 * e os três passos ligados por um fio, com numerais grandes em serifa.
 * Tema escuro (vinho): começo do "entardecer" da página.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';

interface Props {
  titulo: string;
  intro: string;
  passos: { titulo: string; texto: string }[];
}

const { titulo, intro, passos } = Astro.props;
---

<Section labelledby="metodo-titulo" id="metodo" tema="escuro" class="metodo">
  <div class="metodo__cabeca">
    <SectionHeader id="metodo-titulo" titulo={titulo} estilo="t-display-l" />
    <p class="metodo__intro">{intro}</p>
    <p class="rascunho">Rascunho para aprovação</p>
  </div>
  <ol class="list-reset passos" role="list">
    {passos.map((passo, i) => (
      <li class="passo">
        <span class="passo__numero" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="t-h3">{passo.titulo}</h3>
        <p class="passo__texto">{passo.texto}</p>
      </li>
    ))}
  </ol>
  <div class="cta">
    <WhatsAppLink origem="como-funciona" />
  </div>
</Section>

<style>
  .metodo__cabeca {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-9);
  }

  .metodo__cabeca :global(.section-header) {
    margin-block-end: 0;
  }

  .metodo__intro {
    max-width: 38rem;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--color-text-secondary);
  }

  .passo__texto {
    font-size: var(--text-body-m);
    color: var(--color-text-secondary);
  }

  .passos {
    position: relative;
    display: grid;
    gap: var(--space-7);
  }

  .passo {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .passo__numero {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-display-l);
    line-height: 1;
    color: var(--color-text-accent);
  }

  /* Fio que liga os passos (horizontal no desktop). */
  @media (min-width: 56rem) {
    .passos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }

    .passos::before {
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-start: calc(var(--text-display-l) / 2);
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        var(--color-accent-decorative) 15%,
        var(--color-accent-decorative) 85%,
        transparent
      );
    }

    .passo__numero {
      justify-self: start;
      padding-inline-end: var(--space-4);
      background-color: var(--color-bg-default);
      position: relative;
    }
  }

  .cta {
    margin-block-start: var(--space-8);
  }
</style>
