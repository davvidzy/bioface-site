---
/**
 * Home. Job: diferenciar pelo método e reduzir a ansiedade de quem nunca fez.
 * "Como trabalhamos": linha do tempo com as 3 etapas do atendimento.
 *
 * Desktop com movimento (html[data-js], ≥ 64rem, sem reduced motion): a seção fica presa na
 * tela (position: sticky dentro de uma seção alta) e o trilho desliza na horizontal com o
 * scroll; a linha central se desenha e cada etapa acende ao chegar (lib/motion/linha-do-tempo.ts).
 * Celular, sem JS ou reduced motion: tudo em coluna, legível, sem nada escondido.
 * Recriado a partir da referência Timeline (Hyperiux Vault), adaptado ao projeto (Astro, CSS e GSAP).
 *
 * Foto do atendimento à esquerda do trilho (src/assets/metodo/atendimento.jpg).
 */
import { Picture } from 'astro:assets';
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import fotoAtendimento from '@/assets/metodo/atendimento.jpg';

interface Props {
  titulo: string;
  etapas: string;
  passos: { titulo: string; texto: string }[];
}

const { titulo, etapas, passos } = Astro.props;
// Etapas alternam acima e abaixo da linha, como na referência.
const lados = ['cima', 'baixo', 'cima'] as const;
const posicoes = ['24%', '50%', '76%'];
---

<section
  id="metodo"
  class="metodo com-marca-dagua"
  data-theme="escuro"
  aria-labelledby="metodo-titulo"
  data-linha-do-tempo
>
  <div class="metodo__palco">
    {/* Monograma no canto inferior direito; no desktop ele desliza junto com o trilho. */}
    <MarcaDagua
      lado="direita"
      base="-14%"
      tamanho="clamp(16rem, 28vw, 26rem)"
      corte={0.3}
      opacidade={0.08}
      giro={6}
      parallax={false}
      data-ldt-marca
    />
    <div class="metodo__trilho" data-ldt-trilho>
      <div class="metodo__foto">
        <Picture
          src={fotoAtendimento}
          alt="Atendimento na clínica BioFace"
          widths={[600, 900, 1500]}
          sizes="(min-width: 64rem) 50vw, 100vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
      </div>

      <div class="metodo__tempo">
        <div class="metodo__eixo" aria-hidden="true">
          <span class="metodo__ponta"></span>
          <span class="metodo__linha" data-ldt-linha></span>
          <span class="metodo__ponta"></span>
        </div>

        <h2 id="metodo-titulo" class="metodo__titulo">
          {titulo}
        </h2>
        <p class="metodo__etapas">{etapas}</p>

        <ol class="list-reset metodo__lista" role="list">
          {passos.map((passo, i) => (
            <li
              class:list={['etapa', `etapa--${lados[i % lados.length]}`]}
              style={`--pos: ${posicoes[i] ?? '50%'}`}
              data-ldt-etapa
              data-lado={lados[i % lados.length]}
            >
              <span class="etapa__fio" aria-hidden="true" data-ldt-fio></span>
              <span class="etapa__ponto" aria-hidden="true" data-ldt-ponto></span>
              <div class="etapa__texto">
                <h3 class="etapa__titulo">
                  <span class="etapa__mascara" data-ldt-texto>
                    <span class="etapa__numero">{String(i + 1).padStart(2, '0')}</span>
                    {passo.titulo}
                  </span>
                </h3>
                <p class="etapa__descricao">
                  <span class="etapa__mascara" data-ldt-texto>
                    {passo.texto}
                  </span>
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Base: coluna (celular, sem JS, reduced motion) ---------- */
  .metodo {
    padding-block: var(--space-section);
  }

  .metodo__palco {
    position: relative;
  }

  .metodo__trilho {
    display: grid;
    gap: var(--space-8);
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .metodo__foto {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-l);
  }

  /* Fio fino por dentro, como nas fotos dos tratamentos. */
  .metodo__foto::after {
    content: '';
    position: absolute;
    inset: var(--space-3);
    z-index: 1;
    border: 1px solid rgb(250 246 241 / 0.32);
    border-radius: calc(var(--radius-l) - var(--space-2));
    pointer-events: none;
  }

  .metodo__foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .metodo__tempo {
    display: grid;
    gap: var(--space-3);
  }

  .metodo__eixo {
    display: none;
  }

  .metodo__titulo {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-display-l);
    line-height: 1.04;
  }

  .metodo__etapas {
    font-size: var(--text-body-m);
    color: var(--color-text-secondary);
    margin-block-end: var(--space-6);
  }

  .metodo__lista {
    display: grid;
    border-block-start: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 40%, transparent);
  }

  .etapa {
    position: relative;
    padding-block: var(--space-6);
    padding-inline-start: var(--space-6);
    border-block-end: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 40%, transparent);
  }

  .etapa__fio {
    display: none;
  }

  .etapa__ponto {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(var(--space-6) + 0.75rem);
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background-color: var(--color-text-accent);
  }

  .etapa__texto {
    display: grid;
    gap: var(--space-3);
  }

  .etapa__titulo {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
  }

  .etapa__numero {
    margin-inline-end: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-body-s);
    letter-spacing: 0.08em;
    color: var(--color-text-accent);
    vertical-align: middle;
  }

  /* Máscara: o texto sobe de dentro do próprio bloco (movimento no desktop). Corta só na
     vertical (clip), para o título em uma linha poder passar da largura da etapa. */
  .etapa__titulo,
  .etapa__descricao {
    overflow-x: visible;
    overflow-y: clip;
  }

  .etapa__mascara {
    display: block;
  }

  /* Largura em caracteres: as três descrições (~70 caracteres cada) quebram em 2 linhas,
     o mesmo número nas três. */
  .etapa__descricao {
    max-width: 30ch;
    text-wrap: wrap;
    font-size: var(--text-body-m);
    color: var(--color-text-secondary);
  }

  /* ---------- Desktop com movimento: linha do tempo horizontal ---------- */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    :global(html[data-js]) .metodo {
      height: 300vh;
      padding-block: 0;
    }

    :global(html[data-js]) .metodo__palco {
      position: sticky;
      inset-block-start: 0;
      display: flex;
      align-items: center;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
    }

    :global(html[data-js]) .metodo__trilho {
      display: flex;
      align-items: center;
      gap: 5vw;
      width: max-content;
      max-width: none;
      height: min(32vw, 68vh);
      margin: 0;
      /* Começa centralizado (foto e título no meio da tela); sobra no fim para a última
         etapa chegar ao centro antes de a seção soltar. */
      padding-inline: 16vw 30vw;
      will-change: transform;
    }

    :global(html[data-js]) .metodo__foto {
      flex: none;
      height: 100%;
      aspect-ratio: 1 / 1;
    }

    :global(html[data-js]) .metodo__tempo {
      position: relative;
      display: block;
      width: 130vw;
      height: 100%;
    }

    /* Linha central: ponto, fio que se desenha, ponto. */
    :global(html[data-js]) .metodo__eixo {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 50%;
      display: flex;
      align-items: center;
      translate: 0 -50%;
    }

    .metodo__ponta {
      flex: none;
      width: 0.7vw;
      height: 0.7vw;
      border-radius: 50%;
      background-color: var(--color-text-accent);
    }

    .metodo__linha {
      flex: 1;
      height: 1px;
      background-color: var(--color-text-accent);
    }

    :global(html[data-js]) .metodo__titulo {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      max-width: 22vw;
      font-size: clamp(2.5rem, 3.2vw, 4rem);
      line-height: 0.98;
      overflow-wrap: normal;
    }

    :global(html[data-js]) .metodo__etapas {
      position: absolute;
      inset-block-start: calc(50% + 2vw);
      inset-inline-start: 0;
      margin: 0;
      font-size: clamp(1rem, 1.3vw, 1.375rem);
    }

    :global(html[data-js]) .metodo__lista {
      position: absolute;
      inset: 0;
      display: block;
      border: 0;
    }

    :global(html[data-js]) .etapa {
      position: absolute;
      inset-inline-start: var(--pos);
      width: 24vw;
      padding: 0 0 0 2.4vw;
      border: 0;
    }

    :global(html[data-js]) .etapa--cima {
      inset-block: 0 50%;
    }

    :global(html[data-js]) .etapa--baixo {
      inset-block: 50% 0;
      display: flex;
      align-items: flex-end;
    }

    /* Fio vertical entre a linha central e o ponto da etapa. */
    :global(html[data-js]) .etapa__fio {
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      display: block;
      width: 1px;
      background-color: var(--color-text-accent);
    }

    :global(html[data-js]) .etapa__ponto {
      width: 0.9vw;
      height: 0.9vw;
      translate: -50% -50%;
    }

    :global(html[data-js]) .etapa--cima .etapa__ponto {
      inset-block-start: 0;
    }

    :global(html[data-js]) .etapa--baixo .etapa__ponto {
      inset-block: auto 0;
      translate: -50% 50%;
    }

    :global(html[data-js]) .etapa--cima .etapa__texto {
      margin-block-start: -0.6vw;
    }

    /* Títulos das etapas sempre em uma linha. */
    :global(html[data-js]) .etapa__titulo {
      font-size: clamp(1.75rem, 2.3vw, 2.75rem);
      line-height: 1.05;
      white-space: nowrap;
    }

    :global(html[data-js]) .etapa__descricao {
      width: 30ch;
      max-width: 100%;
      font-size: clamp(1rem, 1.25vw, 1.375rem);
      line-height: 1.35;
    }
  }
</style>
