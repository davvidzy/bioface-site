---
/**
 * Home. Job: mostrar amplitude sem sobrecarregar.
 *
 * Índice editorial: os 12 tratamentos em linhas, agrupados pelos 3 objetivos. Cada linha
 * tem número, nome em serifa grande, a dor numa frase e uma seta; a linha inteira é um
 * link para conversar sobre aquele tratamento no WhatsApp (mensagem já com o nome).
 *
 * Desktop com mouse: um selo "Conversar" acompanha o cursor sobre a lista, e a linha
 * sob o cursor ganha fundo e desloca o nome. Celular, toque e reduced motion: só a lista.
 * TODO(conteudo): quando houver fotos por tratamento, o selo pode virar a imagem que segue o cursor.
 */
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import { buildWhatsAppLink } from '@/lib/whatsapp';
import type { Categoria } from '@/data/categorias';
import { isPendente, type Procedimento } from '@/lib/conteudo';

interface Props {
  titulo: string;
  grupos: { categoria: Categoria; procedimentos: Procedimento[] }[];
}

const { titulo, grupos } = Astro.props;
let n = 0;
const linhas = grupos.map(({ categoria, procedimentos }) => ({
  categoria,
  itens: procedimentos.map((p) => ({
    numero: String(++n).padStart(2, '0'),
    nome: p.data.nome,
    problema: isPendente(p.data.problema) ? undefined : p.data.problema,
    href: buildWhatsAppLink({ procedimento: p.data.nome, origem: 'tratamentos' }),
  })),
}));
---

<section
  id="tratamentos"
  class="trat com-marca-dagua"
  aria-labelledby="tratamentos-titulo"
  data-tratamentos
>
  <MarcaDagua lado="direita" topo="38%" corte={0.45} giro={8} />
  <div class="container">
    <header class="trat__cabeca">
      <h2 id="tratamentos-titulo" class="t-display-l" data-reveal="fade">
        {titulo}
      </h2>
    </header>

    <div class="trat__indice" data-trat-indice>
      {linhas.map(({ categoria, itens }) => (
        <section class="grupo" aria-labelledby={`grupo-${categoria.slug}`} data-trat-cat>
          <div class="grupo__cabeca">
            <h3 id={`grupo-${categoria.slug}`} class="grupo__titulo">
              {categoria.rotulo}
            </h3>
            <p class="grupo__descricao">{categoria.descricao}</p>
          </div>
          <ul class="list-reset grupo__lista" role="list">
            {itens.map((item) => (
              <li>
                <a
                  class="linha"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track="whatsapp_click"
                  data-origem="tratamentos"
                  data-procedimento={item.nome}
                >
                  <span class="linha__numero" aria-hidden="true">
                    {item.numero}
                  </span>
                  <span class="linha__texto">
                    <span class="linha__nome">{item.nome}</span>
                    {item.problema && <span class="linha__problema">{item.problema}</span>}
                  </span>
                  <span class="linha__seta" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </span>
                  <span class="visually-hidden">
                    : agendar avaliação pelo WhatsApp (abre o WhatsApp em nova aba)
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <span class="trat__selo" aria-hidden="true" data-trat-selo>
        Conversar
      </span>
    </div>
  </div>
</section>

<style>
  .trat {
    padding-block: var(--space-section);
  }

  .trat__cabeca {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-9);
  }

  .trat__indice {
    position: relative;
    display: grid;
    gap: var(--space-9);
  }

  /* ---------- Grupo (objetivo) ---------- */
  .grupo {
    display: grid;
    gap: var(--space-5);
  }

  .grupo__cabeca {
    display: grid;
    gap: var(--space-2);
  }

  /*
   * Hierarquia em quatro degraus, do maior para o menor:
   * título da seção (Display/L) > objetivo (serifa, entre H2 e H3) >
   * nome do tratamento (serifa, H3) > dor (Inter, Body/M, cor secundária).
   */
  .grupo__titulo {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.4rem + 1.2vw, 2.625rem);
    font-weight: var(--weight-regular);
    line-height: 1.08;
    letter-spacing: -0.005em;
    overflow-wrap: normal;
  }

  .grupo__descricao {
    font-size: var(--text-body-l);
    color: var(--color-text-secondary);
  }

  .grupo__lista {
    border-block-start: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 35%, transparent);
  }

  .grupo__lista > li {
    border-block-end: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 35%, transparent);
  }

  /* ---------- Linha ---------- */
  .linha {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    text-decoration: none;
    color: var(--color-text-primary);
  }

  /* Fundo que entra da esquerda para a direita no hover. */
  .linha::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--space-4));
    z-index: -1;
    border-radius: var(--radius-l);
    background-color: var(--color-bg-subtle);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--motion-fluido);
  }

  .linha__numero {
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
  }

  .linha__texto {
    display: grid;
    gap: var(--space-1);
    transition: transform var(--motion-fluido);
  }

  .linha__nome {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: var(--leading-h3);
  }

  .linha__problema {
    font-size: var(--text-body-m);
    color: var(--color-text-secondary);
  }

  .linha__seta {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 45%, transparent);
    transition:
      transform var(--motion-fluido),
      background-color var(--motion-fluido),
      color var(--motion-fluido),
      border-color var(--motion-fluido);
  }

  .linha:hover::before,
  .linha:focus-visible::before {
    transform: scaleX(1);
    transform-origin: 0% 50%;
  }

  .linha:hover .linha__texto,
  .linha:focus-visible .linha__texto {
    transform: translateX(var(--space-3));
  }

  .linha:hover .linha__seta,
  .linha:focus-visible .linha__seta {
    background-color: var(--color-action-primary-bg);
    border-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
    transform: rotate(-45deg);
  }

  /* ---------- Selo que segue o cursor (só desktop com mouse) ---------- */
  .trat__selo {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .trat__selo {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 6.5rem;
      height: 6.5rem;
      border-radius: 50%;
      background-color: var(--color-action-primary-bg);
      color: var(--color-action-primary-text);
      font-size: var(--text-caption);
      font-weight: var(--weight-medium);
      letter-spacing: 0.04em;
      pointer-events: none;
      opacity: 0;
      scale: 0.4;
      translate: var(--x, 0) var(--y, 0);
      transition:
        opacity var(--motion-fluido),
        scale var(--motion-fluido);
    }

    .trat__indice[data-selo-ativo] .trat__selo {
      opacity: 1;
      scale: 1;
    }
  }

  /* ---------- Desktop: objetivo à esquerda (fixo), tratamentos à direita ---------- */
  @media (min-width: 64rem) {
    .grupo {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 2.2fr);
      gap: var(--space-8);
      align-items: start;
    }

    .grupo__cabeca {
      position: sticky;
      inset-block-start: 7rem;
      padding-block-start: var(--space-5);
    }

    .linha {
      grid-template-columns: 3.5rem 1fr auto;
      padding-block: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linha::before,
    .linha__texto,
    .linha__seta {
      transition: none;
    }
  }
</style>

<script>
  // Selo "Conversar" que acompanha o cursor sobre a lista, com atraso suave (lerp).
  const reduzido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function montar(indice: HTMLElement) {
    if (indice.dataset.montado) return;
    indice.dataset.montado = '';
    const selo = indice.querySelector<HTMLElement>('[data-trat-selo]');
    if (!selo) return;
    let alvoX = 0;
    let alvoY = 0;
    let x = 0;
    let y = 0;
    let quadro = 0;

    const passo = () => {
      x += (alvoX - x) * 0.16;
      y += (alvoY - y) * 0.16;
      const meia = selo.offsetWidth / 2;
      selo.style.setProperty('--x', `${x - meia}px`);
      selo.style.setProperty('--y', `${y - meia}px`);
      quadro =
        Math.abs(alvoX - x) > 0.3 || Math.abs(alvoY - y) > 0.3 ? requestAnimationFrame(passo) : 0;
    };

    indice.addEventListener('pointermove', (e) => {
      if (reduzido() || e.pointerType !== 'mouse') return;
      const r = indice.getBoundingClientRect();
      alvoX = e.clientX - r.left;
      alvoY = e.clientY - r.top;
      const sobreLinha = (e.target as Element).closest('.linha') !== null;
      if (sobreLinha && !indice.hasAttribute('data-selo-ativo')) {
        // Entrando: o selo nasce já no cursor, sem atravessar a tela.
        x = alvoX;
        y = alvoY;
      }
      indice.toggleAttribute('data-selo-ativo', sobreLinha);
      if (!quadro) quadro = requestAnimationFrame(passo);
    });
    indice.addEventListener('pointerleave', () => indice.removeAttribute('data-selo-ativo'));
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-trat-indice]').forEach(montar);
  });
</script>
