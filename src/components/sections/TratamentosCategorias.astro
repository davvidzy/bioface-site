---
/**
 * Home. Job: mostrar amplitude sem sobrecarregar.
 *
 * Três cards com foto, um por objetivo, levando à página da categoria
 * (/tratamentos/[categoria]). Foto de fundo em 2:3 (a proporção das originais, então
 * quase não há recorte e nunca há zoom), degradê vinho embaixo, fio fino por dentro,
 * nome do objetivo em uma palavra, quantidade e "Ver tratamentos".
 * Hover: o card sobe um pouco, o degradê sobe junto e a seta avança. A foto não muda.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import fotoPele from '@/assets/tratamentos/pele.jpg';
import fotoRejuvenescimento from '@/assets/tratamentos/rejuvenescimento.jpg';
import fotoContorno from '@/assets/tratamentos/contorno.jpg';
import type { Categoria } from '@/data/categorias';
import type { Procedimento } from '@/lib/conteudo';

interface Props {
  titulo: string;
  grupos: { categoria: Categoria; procedimentos: Procedimento[] }[];
}

const { titulo, grupos } = Astro.props;
// TODO(validar-cliente): fotos de banco enviadas para a prévia; confirmar licença ou trocar por fotos da clínica.
const fotos: Record<Categoria['slug'], ImageMetadata> = {
  pele: fotoPele,
  rejuvenescimento: fotoRejuvenescimento,
  contorno: fotoContorno,
};
---

<section
  id="tratamentos"
  class="trat com-marca-dagua"
  aria-labelledby="tratamentos-titulo"
  data-tratamentos
>
  <MarcaDagua lado="direita" topo="30%" corte={0.45} giro={8} />
  <div class="container">
    <h2 id="tratamentos-titulo" class="t-display-l trat__titulo" data-reveal="lines">
      {titulo}
    </h2>

    <ul class="list-reset trat__cards" role="list" data-reveal="stagger">
      {grupos.map(({ categoria, procedimentos }) => (
        <li data-trat-cat>
          <a class="card" href={`/tratamentos/${categoria.slug}`}>
            <Picture
              src={fotos[categoria.slug]}
              alt=""
              class="card__foto"
              widths={[400, 640, 900]}
              sizes="(min-width: 56rem) 30vw, 100vw"
              formats={['avif', 'webp']}
              loading="lazy"
            />
            <span class="card__texto">
              <span class="card__nome">
                {categoria.curto}
                <span class="visually-hidden">: {categoria.rotulo}</span>
              </span>
              <span class="card__qtd">{procedimentos.length} tratamentos</span>
              <span class="card__ver">
                Ver tratamentos
                <span class="card__seta" aria-hidden="true">
                  →
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trat {
    padding-block: var(--space-section);
  }

  .trat__titulo {
    margin-block-end: var(--space-8);
  }

  .trat__cards {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .trat__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Celular: carrossel horizontal com encaixe; o card seguinte aparece cortado na borda. */
  @media (max-width: 39.99rem) {
    .trat__cards {
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      gap: var(--space-4);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-block-end: var(--space-5);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .trat__cards::-webkit-scrollbar {
      display: none;
    }

    .trat__cards > li {
      scroll-snap-align: start;
    }
  }

  /* ---------- Card com foto ---------- */
  .card {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-l);
    background-color: var(--wine-900);
    color: var(--cream-50);
    text-decoration: none;
    box-shadow: 0 24px 48px -32px rgb(43 20 32 / 0.55);
    transition:
      translate var(--motion-fluido),
      box-shadow var(--motion-fluido);
  }

  .card :global(.card__foto),
  .card :global(.card__foto img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Degradê vinho embaixo: garante contraste do texto creme sobre qualquer foto. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      0deg,
      rgb(43 20 32 / 0.9) 0%,
      rgb(43 20 32 / 0.55) 30%,
      rgb(43 20 32 / 0) 58%
    );
    transition: opacity var(--motion-fluido);
  }

  /* Fio fino por dentro, como uma moldura. */
  .card::after {
    content: '';
    position: absolute;
    inset: var(--space-3);
    border: 1px solid rgb(250 246 241 / 0.28);
    border-radius: calc(var(--radius-l) - var(--space-2));
    pointer-events: none;
    transition: inset var(--motion-fluido);
  }

  .card__texto {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-7);
  }

  .card__nome {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3.25rem);
    line-height: 1;
  }

  .card__qtd {
    font-size: var(--text-body-s);
    color: rgb(250 246 241 / 0.82);
  }

  .card__ver {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    font-size: var(--text-body-s);
    font-weight: var(--weight-medium);
  }

  .card__seta {
    transition: translate var(--motion-fluido);
  }

  .card:hover {
    translate: 0 -6px;
    box-shadow: 0 32px 56px -30px rgb(43 20 32 / 0.6);
  }

  .card:hover::after {
    inset: var(--space-4);
  }

  .card:hover .card__seta {
    translate: var(--space-2) 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card::after,
    .card__seta {
      transition: none;
    }

    .card:hover {
      translate: none;
    }
  }
</style>
