---
/**
 * Home, seção 5. Job: mostrar amplitude sem sobrecarregar.
 *
 * Três cards, um por categoria: foto e nome. No desktop (com mouse), o card sob o cursor
 * ou com foco cresce em largura (e a foto, em altura) enquanto os outros cedem espaço, e
 * abre a frase da categoria e o link de agendamento. Os tratamentos ficam sempre à vista. Tudo em CSS, sem JS.
 * Celular, toque, sem JS ou reduced motion: os cards já vêm abertos, empilhados.
 * A lista fica sempre no DOM: leitor de tela lê tudo, aberto ou não.
 */
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import type { Categoria } from '@/data/categorias';
import { enfase } from '@/lib/texto';
import type { Procedimento } from '@/lib/conteudo';

interface Props {
  titulo: string;
  grupos: { categoria: Categoria; procedimentos: Procedimento[] }[];
}

const { titulo, grupos } = Astro.props;
---

<section id="tratamentos" class="trat" aria-labelledby="tratamentos-titulo" data-tratamentos>
  <div class="container">
    <h2
      id="tratamentos-titulo"
      class="t-display-l trat__titulo"
      data-reveal="fade"
      set:html={enfase(titulo)}
    />
  </div>

  <div class="trat__largo">
    <ul class="trat__cards list-reset" role="list">
      {grupos.map(({ categoria, procedimentos }) => (
        <li class="cat" data-trat-cat>
          {/* TODO(conteudo): foto 5:4 de cada categoria (procedimento ou detalhe de pele). */}
          <div class="placeholder-media cat__foto">
            <span>Foto · {categoria.rotulo}</span>
          </div>

          <div class="cat__cabeca">
            <h3 class="cat__nome">{categoria.rotulo}</h3>
            <span class="cat__mais" aria-hidden="true"></span>
          </div>

          {/* Os tratamentos ficam sempre à vista: é o que a pessoa procura. */}
          <ul class="list-reset cat__lista" role="list">
            {procedimentos.map((p) => (
              <li>{p.data.nome}</li>
            ))}
          </ul>

          <div class="cat__detalhe">
            <div class="cat__detalhe-interno">
              <p class="cat__descricao">{categoria.descricao}</p>
              <WhatsAppLink
                origem="tratamentos"
                procedimento={categoria.rotulo.toLowerCase()}
                rotulo="Agendar avaliação"
                complementoOculto={`para ${categoria.rotulo.toLowerCase()} pelo WhatsApp`}
                variante="texto"
                class="cat__cta"
              />
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trat {
    --abrir: var(--motion-fluido);
    padding-block: var(--space-section);
  }

  .trat__titulo {
    text-align: center;
    margin-block-end: var(--space-9);
  }

  /* ---------- Base: cards empilhados e abertos (celular, toque, sem JS) ---------- */
  /* Os cards saem do container: ocupam a largura toda, travados em 1440px. */
  .trat__largo {
    width: min(90rem, 100% - 2 * var(--gutter));
    margin-inline: auto;
  }

  .trat__cards {
    display: grid;
    gap: var(--space-9);
  }

  .cat {
    display: grid;
    align-content: start;
  }

  .cat__foto {
    --ratio: 3 / 2;
    width: 100%;
  }

  .cat__cabeca {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-3);
  }

  .cat__nome {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    line-height: var(--leading-h3);
  }

  /* "+" que vira "×" quando o card abre: sinal de que há mais. */
  .cat__mais {
    display: none;
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 45%, transparent);
    border-radius: 50%;
    transition:
      transform var(--abrir),
      background-color var(--abrir),
      border-color var(--abrir);
  }

  .cat__mais::before,
  .cat__mais::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.75rem;
    height: 1.5px;
    background-color: var(--color-text-primary);
    transition: background-color var(--abrir);
  }

  .cat__mais::after {
    transform: rotate(90deg);
  }

  /* Tratamentos em etiquetas: legíveis de relance, sem abrir nada. */
  .cat__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cat__lista li {
    padding: 0.3rem 0.85rem;
    border: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 30%, transparent);
    border-radius: var(--radius-pill);
    font-size: var(--text-body-s);
    line-height: 1.4;
    transition:
      background-color var(--abrir),
      border-color var(--abrir);
  }

  /* Abre com grid-template-rows 0fr → 1fr: altura real animada, sem medir nada em JS. */
  .cat__detalhe {
    display: grid;
    grid-template-rows: 1fr;
  }

  .cat__detalhe-interno {
    display: grid;
    gap: var(--space-4);
    min-height: 0;
    overflow: hidden;
  }

  /* O respiro fica dentro da área recortada: fechado, o detalhe tem altura zero. */
  .cat__descricao {
    margin-block-start: var(--space-4);
    color: var(--color-text-secondary);
  }

  .cat :global(.cat__cta) {
    justify-self: start;
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* ---------- Desktop com mouse: cards lado a lado que crescem no hover ---------- */
  @media (hover: hover) and (pointer: fine) and (min-width: 48rem) {
    .trat__cards {
      display: flex;
      align-items: flex-start;
      gap: 0;
      /* Sem buraco entre os cards: o cursor passa de um para o outro sem fechar tudo. */
    }

    .trat__cards > .cat:first-child {
      padding-inline-start: 0;
    }

    .trat__cards > .cat:last-child {
      padding-inline-end: 0;
    }

    .cat {
      flex: 1 1 0;
      min-width: 0;
      padding-inline: var(--space-3);
      transition: flex-grow var(--abrir);
    }

    .cat:hover,
    .cat:focus-within {
      flex-grow: 1.45;
    }

    .cat__mais {
      display: block;
    }

    .cat:is(:hover, :focus-within) .cat__mais {
      transform: rotate(45deg);
      background-color: var(--color-text-primary);
      border-color: var(--color-text-primary);
    }

    .cat:is(:hover, :focus-within) .cat__mais::before,
    .cat:is(:hover, :focus-within) .cat__mais::after {
      background-color: var(--color-bg-default);
    }

    .cat:is(:hover, :focus-within) .cat__lista li {
      background-color: var(--color-bg-subtle);
      border-color: transparent;
    }

    .cat__foto {
      --ratio: 5 / 4;
    }

    .cat__detalhe {
      grid-template-rows: 0fr;
      transition: grid-template-rows var(--abrir);
    }

    .cat__detalhe-interno {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 0.35s var(--ease-standard),
        transform var(--abrir);
    }

    .cat:hover .cat__detalhe,
    .cat:focus-within .cat__detalhe {
      grid-template-rows: 1fr;
    }

    /* O texto entra um pouco depois do card começar a crescer, como no movimento de referência. */
    .cat:hover .cat__detalhe-interno,
    .cat:focus-within .cat__detalhe-interno {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s var(--ease-standard) 0.15s,
        transform var(--abrir) 0.1s;
    }

    /* Os cards que cedem espaço ficam um pouco mais discretos. */
    .trat__cards:has(.cat:hover, .cat:focus-within) .cat:not(:hover, :focus-within) .cat__foto {
      opacity: 0.75;
    }

    .cat__foto {
      transition: opacity var(--abrir);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat,
    .cat__foto,
    .cat__detalhe,
    .cat__detalhe-interno,
    .cat__mais,
    .cat__mais::before,
    .cat__mais::after,
    .cat__lista li {
      transition: none !important;
    }
  }
</style>
