---
/**
 * Home, seção 5. Job: mostrar amplitude sem sobrecarregar.
 *
 * Fundo: foto desfocada de clínica sob um véu creme (só atmosfera, o conteúdo em destaque).
 *
 * Layout base (celular, reduced motion, sem JS): título, imagem estática da maca e as
 * categorias empilhadas, tudo legível.
 * Desktop com movimento (lib/motion/tratamentos.ts adiciona .trat--animado): a seção
 * inteira fixa na tela (título, maca e categorias juntos), uma categoria por vez
 * alternando os lados, e a maca 3D gira e desliza a cada troca.
 */
import { Picture } from 'astro:assets';
import poster from '@/assets/3d/maca.png';
import fundo from '@/assets/espaco/fundo-tratamentos.jpg';
import type { Categoria } from '@/data/categorias';
import type { Procedimento } from '@/lib/conteudo';

interface Props {
  titulo: string;
  grupos: { categoria: Categoria; procedimentos: Procedimento[] }[];
}

const { titulo, grupos } = Astro.props;
const total = String(grupos.length).padStart(2, '0');
---

<section id="tratamentos" class="trat" aria-labelledby="tratamentos-titulo" data-tratamentos>
  <Picture
    src={fundo}
    alt=""
    class="trat__fundo"
    widths={[960, 1500]}
    sizes="100vw"
    formats={['avif', 'webp']}
    loading="lazy"
  />

  <div class="container trat__conteudo">
    <h2 id="tratamentos-titulo" class="t-h2 trat__titulo">
      {titulo}
    </h2>

    <div class="trat__palco" data-trat-palco>
      <Picture
        src={poster}
        alt=""
        class="trat__poster"
        widths={[480, 800, 1200]}
        sizes="(min-width: 48rem) 36rem, 100vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    </div>

    <ol class="trat__categorias list-reset" role="list">
      {grupos.map(({ categoria, procedimentos }, i) => (
        <li class="trat__cat" data-trat-cat>
          <p class="t-eyebrow eyebrow" aria-hidden="true">
            {String(i + 1).padStart(2, '0')} / {total}
          </p>
          <h3 class="t-h3">{categoria.rotulo}</h3>
          <p class="text-secondary">{categoria.descricao}</p>
          <ul class="list-reset trat__lista" role="list">
            {procedimentos.map((p) => (
              <li>{p.data.nome}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ---------- Fundo ---------- */
  .trat {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-section);
    background-color: var(--color-bg-default);
  }

  .trat__fundo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Véu creme: a foto vira só ambiente; texto vinho mantém contraste AAA. */
  .trat::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--color-bg-default) 88%, transparent);
  }

  /* ---------- Layout base: estático ---------- */
  .trat__conteudo {
    display: grid;
    gap: var(--space-7);
  }

  .trat__titulo {
    text-align: center;
  }

  .trat__palco {
    position: relative;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  .trat__poster {
    width: 100%;
    height: auto;
  }

  .trat__categorias {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .trat__cat {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--color-border-default);
  }

  .trat__lista {
    display: grid;
    gap: var(--space-2);
  }

  /* ---------- Desktop animado (classe aplicada pelo JS) ----------
   * A seção inteira fica fixa: título no alto, maca e categorias na área abaixo dele.
   */
  .trat.trat--animado {
    --area-titulo: clamp(7rem, 22vh, 11rem);
    height: 100vh;
    height: 100svh;
    padding-block: 0;
  }

  .trat--animado .trat__conteudo {
    position: relative;
    display: block;
    height: 100%;
  }

  .trat--animado .trat__titulo {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: var(--area-titulo);
    display: grid;
    align-content: end;
  }

  .trat--animado .trat__palco {
    position: absolute;
    inset: var(--area-titulo) 0 0;
    max-width: none;
  }

  /* No modo animado o poster sai; a maca 3D entra com fade quando carregar. */
  .trat--animado .trat__poster {
    display: none;
  }

  .trat__palco :global(.trat__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out-soft);
  }

  .trat__palco:global(.trat__palco--3d) :global(.trat__canvas) {
    opacity: 1;
  }

  .trat--animado .trat__categorias {
    position: absolute;
    inset: var(--area-titulo) 0 0;
    display: block;
    pointer-events: none;
  }

  .trat--animado .trat__cat {
    /* Centralizado na vertical sem transform: o GSAP anima o y por transform. */
    position: absolute;
    inset-block: 0;
    margin-block: auto;
    height: fit-content;
    width: min(24rem, 30%);
    border-block-start: 0;
    padding-block-start: 0;
  }

  /* Uma categoria para cada lado: 1ª e 3ª à esquerda, 2ª à direita. */
  .trat--animado .trat__cat:nth-child(odd) {
    inset-inline-start: 0;
  }

  .trat--animado .trat__cat:nth-child(even) {
    inset-inline-end: 0;
    text-align: end;
  }
</style>
