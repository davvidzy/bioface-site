---
/**
 * Home. Job: mostrar amplitude sem sobrecarregar.
 *
 * Três cards, um por objetivo. Cada card leva à página da categoria
 * (/tratamentos/[categoria]), onde os tratamentos aparecem em cards próprios.
 * No card: número, quantidade, nome do objetivo em serifa e os nomes dos tratamentos.
 * Hover: um preenchimento sobe de baixo (no espírito do CTA), o card sobe um pouco e a seta gira.
 */
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import type { Categoria } from '@/data/categorias';
import type { Procedimento } from '@/lib/conteudo';

interface Props {
  titulo: string;
  grupos: { categoria: Categoria; procedimentos: Procedimento[] }[];
}

const { titulo, grupos } = Astro.props;
---

<section
  id="tratamentos"
  class="trat com-marca-dagua"
  aria-labelledby="tratamentos-titulo"
  data-tratamentos
>
  <MarcaDagua lado="direita" topo="30%" corte={0.45} giro={8} />
  <div class="container">
    <h2 id="tratamentos-titulo" class="t-display-l trat__titulo" data-reveal="fade">
      {titulo}
    </h2>

    <ul class="list-reset trat__cards" role="list">
      {grupos.map(({ categoria, procedimentos }, i) => (
        <li data-trat-cat>
          <a class="card" href={`/tratamentos/${categoria.slug}`}>
            <span class="card__topo">
              <span class="card__numero" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="card__qtd">{procedimentos.length} tratamentos</span>
            </span>
            <span class="card__nome">{categoria.rotulo}</span>
            <span class="card__lista">{procedimentos.map((p) => p.data.nome).join(' · ')}</span>
            <span class="card__rodape">
              <span class="card__ver">Ver tratamentos</span>
              <span class="card__seta" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trat {
    padding-block: var(--space-section);
  }

  .trat__titulo {
    margin-block-end: var(--space-8);
  }

  .trat__cards {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 56rem) {
    .trat__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-5);
    height: 100%;
    min-height: 24rem;
    padding: var(--space-7) var(--space-6) var(--space-6);
    border-radius: var(--radius-l);
    background-color: var(--color-bg-subtle);
    color: var(--color-text-primary);
    text-decoration: none;
    transition:
      translate var(--motion-fluido),
      box-shadow var(--motion-fluido);
  }

  /* Preenchimento que sobe de baixo no hover. */
  .card::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: -1;
    height: 110%;
    border-radius: 50% 50% 0 0;
    background-color: color-mix(in srgb, var(--gold-200) 45%, var(--color-bg-subtle));
    transition:
      top var(--motion-fluido),
      border-radius var(--motion-fluido);
  }

  .card__topo {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .card__nome {
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 1.4vw, 2.75rem);
    line-height: 1.08;
    max-width: 12ch;
  }

  .card__lista {
    font-size: var(--text-body-s);
    line-height: var(--leading-body-s);
    color: var(--color-text-secondary);
  }

  .card__rodape {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 30%, transparent);
    font-weight: var(--weight-medium);
  }

  .card__seta {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
    transition: rotate var(--motion-fluido);
  }

  .card:hover {
    translate: 0 -4px;
    box-shadow: 0 18px 40px -24px rgb(43 20 32 / 0.35);
  }

  .card:hover::before {
    top: 0;
    border-radius: 0;
  }

  .card:hover .card__seta {
    rotate: -45deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card::before,
    .card__seta {
      transition: none;
    }

    .card:hover {
      translate: none;
    }
  }
</style>
