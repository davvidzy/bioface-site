---
/**
 * Endereço, horários e mapa da clínica.
 * Desktop: endereço e horários à esquerda, mapa à direita. Celular: tudo em coluna.
 * O mapa é o embed oficial do Google Maps (ficha da clínica), com loading="lazy": só
 * carrega quando chega perto da tela. O link "Ver no Google Maps" continua como
 * alternativa em texto.
 */
import Pendente from '@/components/ui/Pendente.astro';
import { site, enderecoCompleto, linkGoogleMaps } from '@/data/site';
import { localizacao as t } from '@/data/textos';

interface Props {
  /** Nível dos subtítulos, para manter a hierarquia da página. */
  nivel?: 'h3' | 'h4';
}

const { nivel: Tag = 'h3' } = Astro.props;
const endereco = enderecoCompleto();
const mapsLink = linkGoogleMaps();
const hora = (h: string) => h.replace(/^0/, '').replace(':00', 'h').replace(':', 'h');
---

<div class="localizacao">
  <div class="localizacao__info">
    <div>
      <Tag class="t-eyebrow localizacao__titulo">{t.endereco}</Tag>
      {endereco ? (
        <address>
          {site.endereco.logradouro}
          <br />
          {site.endereco.bairro}, {site.endereco.cidade}/{site.endereco.uf}
          <br />
          CEP {site.endereco.cep}
        </address>
      ) : (
        <>
          <p>
            {site.endereco.bairro}, {site.endereco.cidade}/{site.endereco.uf}
          </p>
          <Pendente texto="endereço completo e CEP" />
        </>
      )}
      <p>
        <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="localizacao__link">
          {t.mapa} <span aria-hidden="true">→</span>
          <span class="visually-hidden">(abre em nova aba)</span>
        </a>
      </p>
    </div>

    <div>
      <Tag class="t-eyebrow localizacao__titulo">{t.horarios}</Tag>
      {site.horarios.length > 0 ? (
        <dl class="horarios">
          {site.horarios.map((h) => (
            <div>
              <dt>{h.rotulo}</dt>
              <dd>
                {hora(h.abre)} às {hora(h.fecha)}
              </dd>
            </div>
          ))}
          {site.fechado && (
            <div>
              <dt>{site.fechado}</dt>
              <dd>Fechado</dd>
            </div>
          )}
        </dl>
      ) : (
        <Pendente texto="horários de atendimento" />
      )}
    </div>
  </div>

  <div class="localizacao__mapa">
    <iframe
      src={site.mapaEmbed}
      title={t.tituloMapa}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
  </div>
</div>

<style>
  .localizacao {
    display: grid;
    gap: var(--space-8);
  }

  .localizacao__info {
    display: grid;
    gap: var(--space-7);
    align-content: start;
  }

  .localizacao__titulo {
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    color: var(--color-text-accent);
    margin-block-end: var(--space-3);
  }

  address {
    font-style: normal;
    font-size: var(--text-body-m);
    line-height: 1.6;
  }

  .localizacao__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    margin-block-start: var(--space-2);
    font-size: var(--text-body-s);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .horarios {
    display: grid;
    gap: var(--space-2);
    max-width: 22rem;
    font-size: var(--text-body-m);
  }

  .horarios div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block-end: var(--space-2);
    border-block-end: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 25%, transparent);
  }

  .horarios dd {
    color: var(--color-text-secondary);
  }

  /* Mapa em moldura arredondada, no mesmo padrão das fotos. */
  .localizacao__mapa {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-l);
    background-color: var(--color-bg-default);
  }

  .localizacao__mapa iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (min-width: 56rem) {
    .localizacao {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-10);
      align-items: start;
    }

    .localizacao__mapa {
      aspect-ratio: 16 / 10;
    }
  }
</style>
