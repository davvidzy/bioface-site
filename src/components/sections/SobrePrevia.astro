---
/**
 * Home. Job: autoridade e vínculo humano.
 * Layout do Figma (node 18:5): foto da Maria à esquerda, em moldura alta com cantos
 * arredondados; à direita, centralizados na altura, o nome em display, a formação e a
 * frase dela em itálico com um fio dourado.
 * Tema escuro (vinho), seguindo o Método: o "entardecer" da página.
 */
import { Picture } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Texto from '@/components/ui/Texto.astro';
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import foto from '@/assets/pessoas/maria.png';
import { isPendente } from '@/lib/conteudo';

interface Props {
  titulo: string;
  subtitulo: string;
  citacao: string;
  alt: string;
}

const { titulo, subtitulo, citacao, alt } = Astro.props;
---

<Section labelledby="sobre-titulo" id="sobre" tema="escuro" class="com-marca-dagua">
  <MarcaDagua
    lado="direita"
    base="4%"
    tamanho="clamp(12rem, 22vw, 20rem)"
    corte={0.5}
    opacidade={0.06}
    giro={8}
  />
  <div class="sobre">
    <figure class="sobre__foto" data-reveal="imagem">
      <Picture
        src={foto}
        alt={alt}
        widths={[480, 720, 941]}
        sizes="(min-width: 56rem) 33vw, 100vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    </figure>

    <div class="sobre__texto">
      <h2 id="sobre-titulo" class="sobre__nome" data-reveal="lines">
        {titulo}
      </h2>
      <p class="sobre__subtitulo" data-reveal="fade">{subtitulo}</p>

      {isPendente(citacao) ? (
        <Texto texto={citacao} />
      ) : (
        <blockquote class="sobre__citacao" data-reveal="fade">
          <p>“{citacao}”</p>
        </blockquote>
      )}
    </div>
  </div>
</Section>

<style>
  /* Medidas do Figma (frame de 1440px): foto 469 × 723, raio 25; nome 82px; formação
     20px; frase 38px / 1,13 com fio de 2px; 32px entre os blocos. */
  .sobre {
    display: grid;
    gap: var(--space-8);
  }

  .sobre__foto :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 469 / 723;
    object-fit: cover;
    object-position: center;
    border-radius: 1.5625rem;
  }

  .sobre__texto {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-6);
  }

  .sobre__nome {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: clamp(3rem, 1.9rem + 4.1vw, 5.125rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .sobre__subtitulo {
    font-size: clamp(1.0625rem, 0.95rem + 0.35vw, 1.25rem);
    color: var(--color-text-secondary);
  }

  /* Frase da Maria: serifa itálica com um fio dourado à esquerda. */
  .sobre__citacao {
    display: flex;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding-inline-start: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1.3vw, 2.375rem);
    font-style: italic;
    line-height: 1.13;
    color: var(--color-text-primary);
  }

  .sobre__citacao::before {
    content: '';
    flex: none;
    width: 2px;
    border-radius: 5px;
    background-color: var(--gold-600);
  }

  .sobre__citacao p {
    max-width: 23ch;
  }

  @media (min-width: 56rem) {
    /* Foto e texto formam um bloco único, centralizado na tela. Pode passar um pouco da
       largura do container (até 4rem da borda) para a frase caber em 2 linhas. */
    .sobre {
      margin-inline: min(0px, (100% - (100vw - 8rem)) / 2);
      grid-template-columns: auto minmax(0, max-content);
      justify-content: center;
      column-gap: clamp(var(--space-8), 6vw, 6.5rem);
      align-items: center;
    }

    /* A foto ocupa quase a altura da tela, sem passar dela. */
    .sobre__foto {
      width: min(34vw, calc(88svh * 469 / 723));
    }

    .sobre__citacao p {
      max-width: 17.5em;
    }
  }

  /* Celular: foto menos alta, para o nome aparecer logo em seguida. */
  @media (max-width: 55.99rem) {
    .sobre__foto :global(img) {
      aspect-ratio: 4 / 5;
      object-position: center 20%;
    }
  }
</style>
