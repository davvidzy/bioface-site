---
/**
 * Home. Job: autoridade e vínculo humano.
 * Foto grande da Maria, nome em display, uma frase dela em destaque e a trajetória.
 * Desktop: foto à esquerda ocupando a altura; texto à direita, alinhado à base da foto.
 * Tema escuro (vinho), seguindo o Método: o "entardecer" da página.
 */
import { Picture } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Texto from '@/components/ui/Texto.astro';
import foto from '@/assets/pessoas/hero-mobile.jpg';
import { isPendente } from '@/lib/conteudo';

interface Props {
  titulo: string;
  subtitulo: string;
  texto: string;
  citacao: string;
  alt: string;
}

const { titulo, subtitulo, texto, citacao, alt } = Astro.props;
---

<Section labelledby="sobre-titulo" id="sobre" tema="escuro">
  <div class="sobre">
    <figure class="sobre__foto" data-reveal="fade">
      <Picture
        src={foto}
        alt={alt}
        widths={[480, 800, 1100]}
        sizes="(min-width: 56rem) 40vw, 100vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    </figure>

    <div class="sobre__texto">
      <div class="sobre__nome">
        <h2 id="sobre-titulo" class="t-display-xl" data-reveal="fade">
          {titulo}
        </h2>
        <p class="sobre__subtitulo">{subtitulo}</p>
      </div>

      {isPendente(citacao) ? (
        <Texto texto={citacao} />
      ) : (
        <blockquote class="sobre__citacao">
          <p>{citacao}</p>
        </blockquote>
      )}

      <Texto texto={texto} class="t-body-l sobre__trajetoria" />
      <p class="rascunho">Frase e trajetória: rascunho para aprovação</p>
    </div>
  </div>
</Section>

<style>
  .sobre {
    display: grid;
    gap: var(--space-8);
  }

  .sobre__foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 60% 15%;
    border-radius: var(--radius-l);
  }

  .sobre__texto {
    display: grid;
    gap: var(--space-7);
    align-content: end;
    max-width: 36rem;
  }

  .sobre__nome {
    display: grid;
    gap: var(--space-3);
  }

  .sobre__subtitulo {
    color: var(--color-text-secondary);
    font-size: var(--text-body-l);
  }

  /* Frase da Maria: serifa itálica grande com um fio dourado à esquerda. */
  .sobre__citacao {
    margin: 0;
    padding-inline-start: var(--space-6);
    border-inline-start: 1px solid var(--gold-600);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-style: italic;
    line-height: var(--leading-h2);
  }

  .sobre__trajetoria {
    color: var(--color-text-secondary);
  }

  @media (min-width: 56rem) {
    .sobre {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(var(--space-8), 7vw, 8rem);
      align-items: end;
    }
  }
</style>
