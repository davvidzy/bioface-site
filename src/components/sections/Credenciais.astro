---
/**
 * Home, seção 3. Job: transformar promessa em fato.
 * Só fatos com fonte. Sem contador animado, sem número sem origem.
 */
import Section from '@/components/ui/Section.astro';
import Pendente from '@/components/ui/Pendente.astro';

export interface Credencial {
  valor: string;
  rotulo: string;
  pendente?: boolean;
}

interface Props {
  titulo: string;
  itens: Credencial[];
}

const { titulo, itens } = Astro.props;
---

<Section labelledby="credenciais-titulo" sutil>
  <h2 id="credenciais-titulo" class="visually-hidden">
    {titulo}
  </h2>
  <ul class="credenciais list-reset" role="list">
    {itens.map((item) =>
      item.pendente ? (
        <Pendente as="li" texto={item.rotulo} />
      ) : (
        <li class="credenciais__item">
          <span class="t-h3 credenciais__valor">{item.valor}</span>
          <span class="t-body-s text-secondary">{item.rotulo}</span>
        </li>
      ),
    )}
  </ul>
</Section>

<style>
  .credenciais {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .credenciais__item {
    display: grid;
    gap: var(--space-1);
  }
</style>
