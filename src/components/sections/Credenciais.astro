---
/**
 * Home, logo abaixo do hero. Job: transformar promessa em fato.
 * Faixa discreta e padronizada: cada fato é "valor curto + rótulo curto", na mesma escala,
 * separados por fios finos. Só fatos confirmados no brief: nada de contador animado,
 * número sem fonte ou nota inventada.
 */
interface Props {
  itens: { valor: string; rotulo: string }[];
}

const { itens } = Astro.props;
---

<section class="credenciais" aria-label="Em resumo">
  <dl class="container credenciais__lista">
    {itens.map((item) => (
      <div class="credenciais__item">
        <dt class="credenciais__rotulo">{item.rotulo}</dt>
        <dd class="credenciais__valor">{item.valor}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .credenciais {
    padding-block: var(--space-6);
  }

  .credenciais__lista {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) 0;
    margin: 0 auto;
  }

  /* Valor em cima, rótulo embaixo (a ordem do <dl> segue a leitura do leitor de tela). */
  .credenciais__item {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0.15rem;
    padding-inline: clamp(var(--space-5), 4vw, var(--space-8));
    text-align: center;
  }

  .credenciais__item + .credenciais__item {
    border-inline-start: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 30%, transparent);
  }

  .credenciais__valor {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .credenciais__rotulo {
    font-size: var(--text-caption);
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
  }

  /* Celular: duas colunas, sem fios. */
  @media (max-width: 40rem) {
    .credenciais__lista {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5) var(--space-3);
    }

    .credenciais__item {
      padding-inline: 0;
    }

    .credenciais__item + .credenciais__item {
      border-inline-start: 0;
    }
  }
</style>
