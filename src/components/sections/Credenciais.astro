---
/**
 * Home, logo abaixo do hero. Job: transformar promessa em fato.
 * Faixa muito discreta: uma linha curta por fato, todas de tamanho parecido, separadas
 * por um ponto dourado. Só fatos confirmados no brief (nada de número sem fonte).
 */
interface Props {
  itens: string[];
}

const { itens } = Astro.props;
---

<section class="credenciais" aria-label="Em resumo">
  <ul class="container list-reset credenciais__lista" role="list" data-reveal="stagger">
    {itens.map((item) => (
      <li class="credenciais__item">{item}</li>
    ))}
  </ul>
</section>

<style>
  .credenciais {
    padding-block: var(--space-5);
  }

  .credenciais__lista {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) 0;
  }

  .credenciais__item {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  /* Ponto dourado entre os itens (decorativo). */
  .credenciais__item + .credenciais__item::before {
    content: '';
    width: 4px;
    height: 4px;
    margin-inline: var(--space-5);
    border-radius: 50%;
    background-color: var(--color-accent-decorative);
  }

  /* Celular: duas colunas alinhadas, sem os pontos. */
  @media (max-width: 40rem) {
    .credenciais__lista {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2) var(--space-4);
      text-align: center;
    }

    .credenciais__item {
      justify-content: center;
    }

    .credenciais__item + .credenciais__item::before {
      display: none;
    }
  }
</style>
