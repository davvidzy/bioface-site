---
/**
 * Home, seção logo após o hero. Job: diferenciar pelo medo central (ficar artificial).
 * Composição editorial: texto de um lado, três fotos verticais (3:4) desencontradas do outro.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Texto from '@/components/ui/Texto.astro';

interface Props {
  titulo: string;
  texto: string;
  /** Quantas fotos 3:4 o layout prevê. Enquanto não houver fotos, viram placeholders. */
  imagens: number;
  id?: string;
}

const { titulo, texto, imagens, id = 'filosofia-titulo' } = Astro.props;
---

<Section labelledby={id} class="filosofia">
  <div class="filosofia__grid">
    <div class="filosofia__texto">
      <SectionHeader id={id} titulo={titulo} estilo="t-display-l" />
      <Texto texto={texto} class="t-body-l" />
    </div>

    <ul class="filosofia__fotos list-reset" role="list">
      {Array.from({ length: imagens }, (_, i) => (
        <li class="placeholder-media filosofia__foto" style="--ratio: 3 / 4" data-reveal="fade">
          <span>Foto {i + 1} · 3:4</span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .filosofia__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .filosofia__texto {
    display: grid;
    gap: var(--space-5);
    max-width: 32rem;
  }

  .filosofia__fotos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  /* Desencontradas: quebra a grade simétrica. */
  .filosofia__foto:nth-child(2) {
    margin-block-start: var(--space-8);
  }

  .filosofia__foto:nth-child(3) {
    margin-block-start: var(--space-5);
  }

  @media (min-width: 56rem) {
    .filosofia__grid {
      grid-template-columns: 5fr 7fr;
    }

    .filosofia__fotos {
      gap: var(--space-5);
    }
  }
</style>
