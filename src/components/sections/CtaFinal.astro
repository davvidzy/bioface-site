---
/**
 * CTA final de cada página. Job: última chance de conversão, sem atrito.
 * Marcado com data-cta-final: o botão flutuante some quando ele está na tela.
 */
import Section from '@/components/ui/Section.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import Localizacao from './Localizacao.astro';
import type { OrigemWhatsApp } from '@/lib/whatsapp';

interface Props {
  titulo: string;
  texto?: string;
  origem: OrigemWhatsApp;
  procedimento?: string | undefined;
  comLocalizacao?: boolean;
}

const { titulo, texto, origem, procedimento, comLocalizacao = false } = Astro.props;
---

<Section labelledby="cta-final-titulo" tema="escuro" data-cta-final>
  <div class="cta">
    <h2 id="cta-final-titulo" class="t-h2" data-reveal="fade">
      {titulo}
    </h2>
    {texto && <p class="t-body-l text-secondary">{texto}</p>}
    <WhatsAppLink origem={origem} procedimento={procedimento} />
  </div>
  {comLocalizacao && (
    <div class="cta__localizacao">
      <Localizacao />
    </div>
  )}
</Section>

<style>
  .cta {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: var(--measure);
  }

  .cta__localizacao {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border-default);
  }
</style>
