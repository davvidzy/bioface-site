---
/**
 * CTA final. Job: última chance de conversão, sem atrito.
 * Seção inteira no vinho mais escuro (wine/950), com o monograma como detalhe e a
 * localização logo abaixo. O rodapé continua no mesmo tom.
 */
import Section from '@/components/ui/Section.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import Marca from '@/components/ui/Marca.astro';
import Localizacao from './Localizacao.astro';
import type { OrigemWhatsApp } from '@/lib/whatsapp';

interface Props {
  titulo: string;
  texto?: string;
  origem: OrigemWhatsApp;
  procedimento?: string | undefined;
  comLocalizacao?: boolean;
}

const { titulo, texto, origem, procedimento, comLocalizacao = false } = Astro.props;
---

<Section labelledby="cta-final-titulo" id="contato" tema="escuro" class="cta-final">
  <div class="cta">
    <Marca tipo="monograma" class="cta__monograma" />
    <div class="cta__conteudo">
      <h2 id="cta-final-titulo" class="t-display-xl" data-reveal="lines">
        {titulo}
      </h2>
      {texto && (
        <p class="cta__texto" data-reveal="fade">
          {texto}
        </p>
      )}
      <WhatsAppLink origem={origem} procedimento={procedimento} />
    </div>
  </div>
  {comLocalizacao && (
    <div class="cta__localizacao">
      <Localizacao />
    </div>
  )}
</Section>

<style>
  /* O vinho mais escuro da página: fim do "entardecer". */
  .cta-final {
    background-color: var(--color-bg-subtle);
  }

  .cta {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-6) var(--space-9);
  }

  .cta__monograma {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    z-index: -1;
    width: clamp(12rem, 30vw, 24rem);
    height: auto;
    translate: 0 -50%;
    color: var(--color-accent-decorative);
    opacity: 0.12;
  }

  .cta__conteudo {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    max-width: 44rem;
  }

  .cta__texto {
    font-size: var(--text-body-l);
    color: var(--color-text-secondary);
    max-width: 32rem;
  }

  .cta__localizacao {
    padding-block-start: var(--space-8);
    border-block-start: var(--border-width) solid
      color-mix(in srgb, var(--color-border-default) 35%, transparent);
  }
</style>
