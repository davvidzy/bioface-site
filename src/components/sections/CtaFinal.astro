---
/**
 * CTA final. Job: última chance de conversão, sem atrito.
 * Um cartão arredondado em vinho dentro da página clara (não é faixa de seção),
 * com o monograma da marca como detalhe. Localização logo abaixo, no fundo claro.
 */
import Section from '@/components/ui/Section.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import Monograma from '@/assets/brand/monograma-mono.svg';
import Localizacao from './Localizacao.astro';
import { enfase } from '@/lib/texto';
import type { OrigemWhatsApp } from '@/lib/whatsapp';

interface Props {
  titulo: string;
  texto?: string;
  origem: OrigemWhatsApp;
  procedimento?: string | undefined;
  comLocalizacao?: boolean;
}

const { titulo, texto, origem, procedimento, comLocalizacao = false } = Astro.props;
---

<Section labelledby="cta-final-titulo" id="contato">
  <div class="cta" data-theme="escuro">
    <Monograma class="cta__monograma" aria-hidden="true" focusable="false" />
    <div class="cta__conteudo">
      <h2 id="cta-final-titulo" class="t-display-l" data-reveal="fade" set:html={enfase(titulo)} />
      {texto && <p class="t-body-l text-secondary">{texto}</p>}
      <WhatsAppLink origem={origem} procedimento={procedimento} variante="destaque" />
    </div>
  </div>
  {comLocalizacao && (
    <div class="cta__localizacao">
      <Localizacao />
    </div>
  )}
</Section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-radius: calc(var(--radius-l) * 1.6);
    padding: clamp(var(--space-7), 6vw, var(--space-10)) clamp(var(--space-5), 6vw, var(--space-9));
  }

  .cta__monograma {
    position: absolute;
    inset-block-end: -12%;
    inset-inline-end: -4%;
    z-index: -1;
    width: clamp(12rem, 34vw, 26rem);
    height: auto;
    color: var(--color-accent-decorative);
    opacity: 0.18;
  }

  .cta__conteudo {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 36rem;
  }

  .cta__localizacao {
    margin-block-start: var(--space-8);
  }
</style>
