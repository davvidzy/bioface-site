---
/**
 * Home. Job: responder objeções antes do direct.
 * Duas colunas no desktop: título fixo à esquerda enquanto as perguntas rolam.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Pendente from '@/components/ui/Pendente.astro';

interface Props {
  titulo: string;
  itens: { pergunta: string; resposta: string }[];
  id?: string;
  /** Âncora da seção na landing page. */
  ancora?: string;
  /** Texto do placeholder quando ainda não há perguntas. */
  pendente?: string;
  tema?: 'claro' | 'escuro';
}

const { titulo, itens, id = 'faq-titulo', ancora, pendente, tema = 'claro' } = Astro.props;
---

<Section labelledby={id} id={ancora} tema={tema}>
  <div class="faq">
    <div class="faq__titulo">
      <SectionHeader id={id} titulo={titulo} estilo="t-display-l" />
    </div>
    {itens.length > 0 ? <Accordion itens={itens} /> : <Pendente texto={pendente ?? ''} />}
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .faq {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-9);
      align-items: start;
    }

    .faq__titulo {
      position: sticky;
      inset-block-start: var(--space-10);
    }
  }
</style>
