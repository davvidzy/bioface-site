---
/**
 * Home. Job: prova social de terceiros.
 * Sem depoimento real, a seção não existe em produção. Em dev, aparece como placeholder.
 */
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Pendente from '@/components/ui/Pendente.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  titulo: string;
  depoimentos: CollectionEntry<'depoimentos'>[];
}

const { titulo, depoimentos } = Astro.props;
const origemRotulo = { google: 'Google', instagram: 'Instagram' } as const;
---

{depoimentos.length > 0 && (
  <Section labelledby="depoimentos-titulo">
    <SectionHeader id="depoimentos-titulo" titulo={titulo} estilo="t-display-l" />
    <ul class="list-reset grid" role="list">
      {depoimentos.map((d) =>
        d.data.pendente ? (
          <Pendente
            as="li"
            texto="depoimentos reais (de preferência do Google). Visível só em desenvolvimento."
          />
        ) : (
          <li>
            <figure>
              <blockquote>
                <p>{d.data.texto}</p>
              </blockquote>
              <figcaption class="t-caption">
                {d.data.autora}, via {origemRotulo[d.data.origem]}
              </figcaption>
            </figure>
          </li>
        ),
      )}
    </ul>
  </Section>
)}
