---
/**
 * Home. Job: em 3 segundos, quem, o quê, onde.
 *
 * Desktop: tela inteira (100svh), dividida ao meio. Texto à esquerda, alinhado à esquerda
 * como o resto do site; foto da Maria à direita, até a borda da tela, sem esfumado.
 * Celular: texto no alto e foto inteira, de borda a borda, logo abaixo (passa da tela).
 *
 * Hierarquia: frase-manifesto (Display/XL, a maior coisa da página), linha de identidade
 * (Maria Guedes · Biomédica esteta · 18 anos · Lago Sul) e o CTA vinho do tema claro.
 *
 * É o LCP da Home: eager, fetchpriority=high e preload no <head> (index.astro).
 */
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import { imagemHero, SIZES_HERO } from '@/lib/hero';
import { enfase } from '@/lib/texto';

interface Props {
  /** Frase-manifesto; um trecho entre *asteriscos* vira itálico. */
  titulo: string;
  identidade: string[];
  alt: string;
}

const { titulo, identidade, alt } = Astro.props;
const img = await imagemHero();
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__texto">
    <h1 id="hero-titulo" class="hero__titulo" set:html={enfase(titulo)} />
    <p class="hero__identidade">
      {identidade.map((parte, i) => (
        <>
          {i > 0 && (
            <span class="hero__sep" aria-hidden="true">
              ·
            </span>
          )}
          <span>{parte}</span>
        </>
      ))}
    </p>
    <WhatsAppLink
      origem="hero"
      rotulo="Agendar avaliação"
      complementoOculto="pelo WhatsApp"
      class="hero__cta"
    />
  </div>

  <picture class="hero__media">
    <source type="image/avif" srcset={img.avif.srcSet.attribute} sizes={SIZES_HERO} />
    <source type="image/webp" srcset={img.webp.srcSet.attribute} sizes={SIZES_HERO} />
    <img
      src={img.jpg.src}
      srcset={img.jpg.srcSet.attribute}
      sizes={SIZES_HERO}
      width={img.meta.width}
      height={img.meta.height}
      alt={alt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
</section>

<style>
  .hero {
    display: grid;
    background-color: var(--color-bg-default);
  }

  .hero__texto {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-6);
    padding: calc(5.5rem + var(--space-6)) var(--gutter) var(--space-8);
  }

  .hero__titulo {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: clamp(3.25rem, 1.6rem + 5.4vw, 7.25rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    max-width: 11ch;
    text-wrap: balance;
  }

  .hero__titulo :global(em) {
    font-style: italic;
  }

  .hero__identidade {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-body-m);
    color: var(--color-text-secondary);
  }

  .hero__identidade > span:first-child {
    color: var(--color-text-primary);
    font-weight: var(--weight-medium);
  }

  .hero__sep {
    color: var(--color-accent-decorative);
  }

  .hero__cta {
    margin-block-start: var(--space-3);
  }

  .hero__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Desktop: duas metades, foto até a borda ---------- */
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
      min-height: 100svh;
    }

    .hero__texto {
      /* Alinha o texto à margem do container do resto da página. */
      padding-inline-start: max(var(--gutter), (100vw - var(--container-max)) / 2 + var(--gutter));
      padding-inline-end: var(--space-8);
      padding-block: calc(5.5rem + var(--space-6)) var(--space-8);
    }

    .hero__media {
      position: relative;
    }

    .hero__media img {
      position: absolute;
      inset: 0;
      height: 100%;
      object-fit: cover;
      object-position: 55% 18%;
    }
  }
</style>
