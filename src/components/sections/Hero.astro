---
/**
 * Home, seção 2. Job: em 3 segundos, quem, o quê, onde. Ocupa a tela inteira (100svh).
 *
 * Imagem com direção de arte por orientação (lib/hero.ts):
 * - paisagem: foto horizontal, Maria à direita, texto à esquerda sobre o fundo claro
 * - retrato: foto vertical, texto embaixo
 * Hierarquia em três degraus, todos em serifa até o CTA: frase-manifesto enorme,
 * subtítulo serifado médio, CTA em pílula com brilho. Texto centralizado na coluna,
 * com uma aura de cor (dourado e rosé da marca) atrás dando presença.
 * Contraste: texto vinho sobre creme + aura clara; medido nos pixels, ≥ 7:1.
 *
 * É o LCP da Home: eager, fetchpriority=high e preload no <head> (index.astro).
 */
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import { imagensHero, MEDIA_RETRATO } from '@/lib/hero';
import { enfase } from '@/lib/texto';

interface Props {
  /** Frase-manifesto; um trecho entre *asteriscos* vira itálico. */
  titulo: string;
  descricao: string;
  alt: string;
}

const { titulo, descricao, alt } = Astro.props;
const { paisagem, retrato } = await imagensHero();
---

<section class="hero" aria-labelledby="hero-titulo" data-cta-principal>
  <picture class="hero__media">
    <source
      media={MEDIA_RETRATO}
      type="image/avif"
      srcset={retrato.avif.srcSet.attribute}
      sizes="100vw"
    />
    <source
      media={MEDIA_RETRATO}
      type="image/webp"
      srcset={retrato.webp.srcSet.attribute}
      sizes="100vw"
    />
    <source media={MEDIA_RETRATO} srcset={retrato.jpg.srcSet.attribute} sizes="100vw" />
    <source type="image/avif" srcset={paisagem.avif.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={paisagem.webp.srcSet.attribute} sizes="100vw" />
    <img
      src={paisagem.jpg.src}
      srcset={paisagem.jpg.srcSet.attribute}
      sizes="100vw"
      width={paisagem.meta.width}
      height={paisagem.meta.height}
      alt={alt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="container hero__conteudo">
    <div class="hero__texto">
      <span class="hero__aura" aria-hidden="true"></span>
      <h1 id="hero-titulo" class="hero__titulo t-display-xl" set:html={enfase(titulo)} />
      <p class="hero__descricao">{descricao}</p>
      <WhatsAppLink
        origem="hero"
        rotulo="Agendar avaliação"
        complementoVisivel=" pelo WhatsApp"
        class="hero__cta"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background-color: var(--color-bg-default);
  }

  /* ---------- Imagem ---------- */
  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    z-index: -3;
  }

  .hero__media img {
    object-fit: cover;
    /* Paisagem: Maria à direita; ao recortar as laterais, preserva o lado dela. */
    object-position: 70% 30%;
  }

  /* ---------- Degradês ----------
   * Topo (header), base (a foto se dissolve na página) e lateral creme onde fica o texto.
   */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg-default) 70%, transparent) 0%,
        transparent 9rem
      ),
      linear-gradient(0deg, var(--color-bg-default) 0%, transparent 32%),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-bg-default) 94%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-default) 80%, transparent) 40%,
        transparent 62%
      );
  }

  /* ---------- Texto ---------- */
  .hero__conteudo {
    padding-block: calc(var(--space-9) + var(--space-3)) var(--space-7);
  }

  .hero__texto {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    width: min(42rem, 100%);
    text-align: center;
    color: var(--color-text-primary);
  }

  /* Aura: duas manchas desfocadas (dourado e rosé), atrás do texto. */
  .hero__aura {
    position: absolute;
    inset: -20% -25%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        closest-side at 38% 45%,
        color-mix(in srgb, var(--color-aura-1) 80%, transparent),
        transparent
      ),
      radial-gradient(
        closest-side at 66% 60%,
        color-mix(in srgb, var(--color-aura-2) 24%, transparent),
        transparent
      );
    filter: blur(24px);
  }

  .hero__titulo {
    text-wrap: balance;
  }

  /* Subtítulo serifado: o degrau do meio da hierarquia.
     Cormorant entre 24px e 34px pede Medium (traços finos). */
  .hero__descricao {
    max-width: 36rem;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-wrap: balance;
  }

  /* CTA com brilho dourado suave. */
  .hero__texto :global(.hero__cta) {
    margin-block-start: var(--space-2);
    box-shadow:
      0 0.75rem 2.5rem color-mix(in srgb, var(--color-aura-1) 70%, transparent),
      0 0.25rem 0.75rem color-mix(in srgb, var(--color-aura-2) 18%, transparent);
  }

  /* Halo que pulsa devagar: CTA chamativo sem ser grande. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__texto :global(.hero__cta) {
      animation: hero-halo 3.2s var(--ease-out-soft) 1.2s infinite;
    }
  }

  @keyframes hero-halo {
    0% {
      box-shadow:
        0 0.75rem 2.5rem color-mix(in srgb, var(--color-aura-1) 70%, transparent),
        0 0 0 0 color-mix(in srgb, var(--color-aura-1) 85%, transparent);
    }
    70%,
    100% {
      box-shadow:
        0 0.75rem 2.5rem color-mix(in srgb, var(--color-aura-1) 70%, transparent),
        0 0 0 0.9rem color-mix(in srgb, var(--color-aura-1) 0%, transparent);
    }
  }

  /* ---------- Retrato (celular e tablet em pé) ----------
   * Texto no alto, centralizado com a aura; a foto ocupa o resto da tela embaixo
   * e se dissolve no creme pelo topo.
   */
  @media (orientation: portrait) {
    .hero {
      align-items: start;
    }

    .hero::before {
      display: none;
    }

    .hero__conteudo {
      padding-block: calc(5.5rem + var(--space-5)) var(--space-5);
    }

    .hero__texto {
      width: 100%;
      gap: var(--space-5);
    }

    /* 24px: mínimo da Cormorant (em Medium) e cabe em 2 linhas no celular. */
    .hero__descricao {
      font-size: 1.5rem;
    }

    /* Foto ancorada na base com altura própria: se o texto mudar de altura quando a
       fonte chega, a foto não se move (sem CLS). */
    .hero__media {
      inset: auto 0 0;
      height: 54svh;
      z-index: -3;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 60%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 60%);
    }

    .hero__media img {
      object-position: 55% 12%;
    }
  }
</style>
