---
/**
 * Home, seção 2. Job: em 3 segundos, quem, o quê, onde. Ocupa a tela inteira (100svh).
 *
 * Imagem com direção de arte por orientação (lib/hero.ts):
 * - paisagem: foto horizontal, Maria à direita, texto à esquerda sobre o fundo claro
 * - retrato: foto vertical, texto embaixo
 * Hierarquia em três degraus: frase-manifesto em serifa grande, descrição curta em Body
 * e o CTA. Tudo alinhado à esquerda na coluna,
 * com uma aura de cor (dourado e rosé da marca) atrás dando presença.
 * Contraste: texto vinho sobre creme + aura clara; medido nos pixels, ≥ 7:1.
 *
 * É o LCP da Home: eager, fetchpriority=high e preload no <head> (index.astro).
 */
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import MarcaDagua from '@/components/ui/MarcaDagua.astro';
import { imagensHero, MEDIA_RETRATO } from '@/lib/hero';
import { enfase } from '@/lib/texto';

interface Props {
  /** Frase-manifesto; um trecho entre *asteriscos* vira itálico. */
  titulo: string;
  descricao: string;
  alt: string;
}

const { titulo, descricao, alt } = Astro.props;
const { paisagem, retrato } = await imagensHero();
---

<section class="hero" aria-labelledby="hero-titulo">
  <MarcaDagua
    lado="esquerda"
    base="-6%"
    tamanho="clamp(16rem, 30vw, 28rem)"
    corte={0.4}
    opacidade={0.08}
    giro={-6}
  />
  <picture class="hero__media entrada-foto">
    <source
      media={MEDIA_RETRATO}
      type="image/avif"
      srcset={retrato.avif.srcSet.attribute}
      sizes="100vw"
    />
    <source
      media={MEDIA_RETRATO}
      type="image/webp"
      srcset={retrato.webp.srcSet.attribute}
      sizes="100vw"
    />
    <source media={MEDIA_RETRATO} srcset={retrato.jpg.srcSet.attribute} sizes="100vw" />
    <source type="image/avif" srcset={paisagem.avif.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={paisagem.webp.srcSet.attribute} sizes="100vw" />
    <img
      src={paisagem.jpg.src}
      srcset={paisagem.jpg.srcSet.attribute}
      sizes="100vw"
      width={paisagem.meta.width}
      height={paisagem.meta.height}
      alt={alt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="container hero__conteudo">
    <div class="hero__texto entrada">
      <span class="hero__aura" aria-hidden="true"></span>
      <h1 id="hero-titulo" class="hero__titulo t-display-xl" set:html={enfase(titulo)} />
      <p class="hero__descricao">{descricao}</p>
      <WhatsAppLink
        origem="hero"
        rotulo="Agendar avaliação"
        complementoOculto="pelo WhatsApp"
        class="hero__cta"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    /* Corta só nas laterais: o monograma do canto pode descer sobre a seção seguinte e
       aparecer inteiro (z-index 1 deixa o hero pintado por cima dela). */
    z-index: 1;
    overflow-x: clip;
    background-color: var(--color-bg-default);
  }

  /* ---------- Imagem ---------- */
  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__media {
    z-index: -3;
  }

  .hero__media img {
    object-fit: cover;
    /* Paisagem: Maria à direita; ao recortar as laterais, preserva o lado dela. */
    object-position: 70% 30%;
  }

  /* ---------- Degradês ----------
   * Topo (header), base (a foto se dissolve na página) e lateral creme onde fica o texto.
   */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg-default) 70%, transparent) 0%,
        transparent 9rem
      ),
      linear-gradient(0deg, var(--color-bg-default) 0%, transparent 32%),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-bg-default) 94%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-default) 80%, transparent) 40%,
        transparent 62%
      );
  }

  /* ---------- Texto ---------- */
  .hero__conteudo {
    padding-block: calc(var(--space-9) + var(--space-3)) var(--space-7);
  }

  .hero__texto {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    width: min(44rem, 100%);
    text-align: start;
    color: var(--color-text-primary);
  }

  /* Aura: duas manchas desfocadas (dourado e rosé), atrás do texto. */
  /* Halo com tamanho fixo (em relação à tela, não ao bloco de texto): quando a fonte
     chega e o texto muda de altura, ele não se move (era a única mudança de layout, CLS). */
  .hero__aura {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: min(150%, 60rem);
    height: min(90vh, 42rem);
    transform: translate(-50%, -50%); /* transform, não translate: a entrada anima o translate */
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        closest-side at 38% 45%,
        color-mix(in srgb, var(--color-aura-1) 80%, transparent),
        transparent
      ),
      radial-gradient(
        closest-side at 66% 60%,
        color-mix(in srgb, var(--color-aura-2) 24%, transparent),
        transparent
      );
    filter: blur(24px);
  }

  /* Desktop: duas linhas ("Natural é quando o / resultado parece seu."). */
  .hero__titulo {
    font-size: clamp(3rem, 1.4rem + 3.6vw, 4.75rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  /* Descrição em texto corrido (Body/L), discreta: o título é quem fala alto. */
  .hero__descricao {
    max-width: 30rem;
    font-family: var(--font-body);
    font-size: var(--text-body-l);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: balance;
  }

  /* ---------- Retrato (celular e tablet em pé) ----------
   * Quebra os 100svh de propósito: o texto desce com bastante respiro e a Maria aparece
   * inteira logo abaixo, dissolvida no fundo em cima e embaixo (página contínua).
   */
  @media (orientation: portrait) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .hero__conteudo {
      order: 1;
    }

    .hero::before {
      display: none;
    }

    .hero__conteudo {
      padding-block: calc(6.75rem + var(--space-9)) var(--space-4);
    }

    /* Celular: tudo centralizado. */
    .hero__texto {
      width: 100%;
      gap: var(--space-5);
      justify-items: center;
      text-align: center;
    }

    /* Celular: título em 3 linhas, descrição em Body/M e 2 linhas. */
    .hero__titulo {
      font-size: clamp(2.75rem, 1.5rem + 5.5vw, 3.5rem);
    }

    .hero__descricao {
      max-width: 21rem;
      font-size: var(--text-body-m);
    }

    .hero__media {
      order: 2;
      position: relative;
      inset: auto;
      display: block;
      height: auto;
      z-index: auto;
      margin-block-start: calc(-1 * var(--space-8));
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0%,
        #000 28%,
        #000 82%,
        transparent 100%
      );
      mask-image: linear-gradient(180deg, transparent 0%, #000 28%, #000 82%, transparent 100%);
    }

    .hero__media img {
      position: static;
      width: 100%;
      height: auto;
      object-fit: contain;
    }
  }
</style>
