---
/**
 * Layout base: <html lang="pt-BR">, SEO, skip link, landmarks, ClientRouter e init de motion.
 */
import { ClientRouter, fade } from 'astro:transitions';
import '@/styles/reset.css';
import '@/styles/tokens.css';
import '@/styles/typography.css';
import '@/styles/global.css';

import SkipLink from '@/components/layout/SkipLink.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import {
  SITE_NAME,
  DEFAULT_OG_IMAGE,
  INDEXAR,
  absoluteUrl,
  nomeOg,
  type SeoProps,
} from '@/lib/seo';

type Props = SeoProps & {
  /** Header por cima do primeiro bloco da página (hero em tela cheia). */
  headerSobreposto?: boolean;
};

const {
  title,
  description,
  path,
  image,
  noindex = false,
  jsonLd = [],
  headerSobreposto = false,
} = Astro.props;

const canonical = absoluteUrl(path, Astro.site);
// Transição de página da Fase 0: fade simples só no conteúdo. Duração = --duration-page.
// Com prefers-reduced-motion, o Astro desliga a animação.
const transicaoPagina = fade({ duration: '0.45s' });
// Imagem OG por página (scripts/og.mjs); sem arquivo gerado, usa a padrão.
const ogDaRota = `/og/${nomeOg(path)}.png`;
const ogPadrao = existsSync(join(process.cwd(), 'public', ogDaRota)) ? ogDaRota : DEFAULT_OG_IMAGE;
const ogImage = absoluteUrl(image ?? ogPadrao, Astro.site);
const robots = noindex || !INDEXAR;
---

<!doctype html>
<html lang="pt-BR" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marca "JS disponível" antes da pintura: enhancements entram sem salto de layout. -->
    <script is:inline>
      document.documentElement.dataset.js = '';
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="preload"
      href="/fonts/newsreader-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <SkipLink />
    <Header sobreposto={headerSobreposto} />
    <main id="conteudo" tabindex="-1" transition:animate={transicaoPagina}>
      <slot />
    </main>
    <Footer />

    <script>
      import { initTracking } from '@/lib/analytics';
      import { initAncoras } from '@/lib/ancoras';
      initTracking();
      initAncoras();

      // Header suspenso: depois de rolar um pouco, a barra vira pílula flutuante.
      const LIMITE_HEADER = 80;
      // Suspenso, a barra passa para o tema escuro (vinho); no topo, fica no tema claro.
      const atualizarHeader = () => {
        const suspenso = window.scrollY > LIMITE_HEADER;
        document.querySelector('[data-header]')?.toggleAttribute('data-flutuante', suspenso);
        const barra = document.querySelector<HTMLElement>('[data-header-barra]');
        if (barra) {
          if (suspenso) barra.dataset['theme'] = 'escuro';
          else delete barra.dataset['theme'];
        }
      };
      window.addEventListener('scroll', atualizarHeader, { passive: true });
      document.addEventListener('astro:page-load', atualizarHeader);
      atualizarHeader();

      // O ClientRouter troca os atributos do <html> na navegação; a marca precisa voltar.
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.dataset['js'] = '';
      });

      // Movimento é enhancement: GSAP e Lenis (~60 KB) só baixam na primeira interação
      // (scroll, toque, ponteiro ou tecla), fora do caminho crítico do LCP.
      // Até lá todo conteúdo já está visível; quem não interage não precisa de animação.
      const GATILHOS = ['scroll', 'wheel', 'touchstart', 'pointerdown', 'pointermove', 'keydown'];
      let pedido = false;
      const carregarMovimento = () => {
        if (pedido) return;
        pedido = true;
        GATILHOS.forEach((e) => window.removeEventListener(e, carregarMovimento));
        import('@/lib/motion/lifecycle').then((m) => m.iniciarMovimento());
      };
      GATILHOS.forEach((e) =>
        window.addEventListener(e, carregarMovimento, { passive: true, once: true }),
      );
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
